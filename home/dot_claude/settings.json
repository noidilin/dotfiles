{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/noid/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "aws-agents@claude-plugins-official": true,
    "credit-report-generator@robcsc-skills-repo": true,
    "invest-report@robcsc-skills-repo": true,
    "desktop-skills@desktop-skills-bridge": true
  },
  "extraKnownMarketplaces": {
    "robcsc-skills-repo": {
      "source": {
        "source": "file",
        "path": "/Users/noid/hub/lab/multi-agent/fubon-AWS-agent/.claude-plugin/marketplace.json"
      }
    },
    "desktop-skills-bridge": {
      "source": {
        "source": "directory",
        "path": "/Users/noid/.claude/desktop-skills-bridge"
      }
    }
  },
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-sonnet-4-6": {
      "effortLevel": "low"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:achroma-current"
}

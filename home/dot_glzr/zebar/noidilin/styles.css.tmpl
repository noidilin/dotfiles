@import 'https://www.nerdfonts.com/assets/css/webfont.css';

:root {
{{ template "zebar-achroma-vars.css" (dict
     "c" .color.achroma.light
     "ink" (dict "crust" "#f2f2f2")) -}}
}

:root.dark {
{{ template "zebar-achroma-vars.css" (dict
     "c" .color.achroma.dark
     "ink" (dict "crust" .color.achroma.dark.crust)) -}}
}

html {
  width: calc(100% - 20px);
  position: absolute;
  right: 10px;
  background: var(--crust);
}

i {
  color: var(--overlay2);
  margin-right: 7px;
}

body {
  font-family: 'CommitMono Nerd Font Mono', ui-monospace, monospace;
  color: var(--subtext1);
  font-size: 12px;
  font-weight: 500;
}

html,
body,
#root {
  height: 100%;
}

#root {
  border: 1px solid var(--surface2);
  border-radius: 10px;
  background: var(--mantle);
}

.app {
  display: grid;
  grid-template-columns: 1fr 2fr 1fr;
  align-items: center;
  height: 100%;
  padding: 4px 24px;
}

.left,
.center,
.right {
  display: flex;
  align-items: center;
}

.center {
  justify-self: center;
}

.right {
  justify-self: end;
}

.logo,
.binding-mode,
.network,
.memory,
.cpu,
.battery,
.weather,
.clock {
  margin-right: 20px;
}

.workspaces {
  display: flex;
  align-items: center;
}

.workspace {
  font-size: 18px;
  color: var(--overlay2);
  background: var(--mantle);
  margin-right: 4px;
  padding: 0px 8px;
  border: none;
  border-radius: 2px;
  cursor: pointer;

  &.displayed {
    background: var(--mantle);
    color: var(--overlay2);
  }

  &.focused,
  &:hover {
    background: var(--surface1);
    color: var(--accent7);
  }
}

.binding-mode,
.tiling-direction {
  background: var(--surface1);
  color: var(--text);
  border-radius: 2px;
  line-height: 1;
  padding: 4px 8px;
  border: 0;
  cursor: pointer;
}

.binding-mode {
  margin-right: 4px;
}

.cpu .high-usage {
  color: var(--red);
}

.battery .charging-icon {
  position: absolute;
  font-size: 11px;
  left: 7px;
  top: 2px;
}

.sep {
  color: var(--subtext1);
  background: transparent;
  margin-right: 16px;
}

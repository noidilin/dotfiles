{{- $envData := include ".chezmoidata/env.yml" | fromYaml -}}
{{- $osId := .chezmoi.os -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if hasKey .chezmoi.osRelease "id" -}}
{{-     $osId = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{-   end -}}
{{- end -}}

{{- $isWsl := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
{{-     $isWsl = true -}}
{{-   end -}}
{{- end -}}

{{- $archEnv := "" -}}
{{- if eq $osId "linux-arch" -}}
{{-   if $isWsl -}}
{{-     $archEnv = "wsl" -}}
{{-   else -}}
{{-     $archEnv = "native" -}}
{{-   end -}}
{{- end -}}

{{- $shell := "bash" -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $shell = "pwsh" -}}
{{- end -}}
encryption = "age"
progress = true

[age]
identity = "{{ .chezmoi.homeDir }}/.config/chezmoi/.chezmoi-crypto-key.txt"
recipient = "age142jxxglda43ghtr5l27h06arhazze8lleu80lap0s2sfawjywgqqj9pnc2"

[completion]
custom = true

[data]
  osId = {{ $osId | quote }}
  isWsl = {{ $isWsl }}
  archEnv = {{ $archEnv | quote }}
  shell = {{ $shell | quote }}

[scriptEnv]
{{- range $key, $pathParts := $envData.env.xdg }}
  {{ $key }} = {{ printf "%s/%s" $.chezmoi.homeDir (join "/" $pathParts) | quote }}
{{- end }}
{{- range $key, $pathParts := $envData.env.dev }}
  {{ $key }} = {{ printf "%s/%s" $.chezmoi.homeDir (join "/" $pathParts) | quote }}
{{- end }}
{{- range $key, $pathParts := $envData.env.other }}
  {{ $key }} = {{ printf "%s/%s" $.chezmoi.homeDir (join "/" $pathParts) | quote }}
{{- end }}

{{- if $isWsl }}
[onepassword]
command = "op.exe"
{{- end }}

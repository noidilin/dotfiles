encryption = "age"
progress = true # display progress bar

[age]
identity = "{{ .chezmoi.homeDir }}/.config/.age-key.txt"
recipient = "age142jxxglda43ghtr5l27h06arhazze8lleu80lap0s2sfawjywgqqj9pnc2"

[completion]
custom = true # enable custom shell completion

{{/* ========================================== */}}
{{/* Helper Variables for Template Logic       */}}
{{/* ========================================== */}}

{{/* Determine OS identifier with granular Linux detection */}}
{{- $osId := .chezmoi.os -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if hasKey .chezmoi.osRelease "id" -}}
{{-     $osId = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{-   end -}}
{{- end -}}

{{/* Detect WSL2 environment */}}
{{- $isWsl := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
{{-     $isWsl = true -}}
{{-   end -}}
{{- end -}}

{{/* Determine environment type for Arch Linux */}}
{{- $archEnv := "" -}}
{{- if eq $osId "linux-arch" -}}
{{-   if $isWsl -}}
{{-     $archEnv = "wsl" -}}
{{-   else -}}
{{-     $archEnv = "native" -}}
{{-   end -}}
{{- end -}}

{{/* Default shell per platform */}}
{{- $shell := "bash" -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $shell = "pwsh" -}}
{{- end -}}

[data]
  osId = {{ $osId | quote }} # "windows", "linux-arch", "darwin"
  isWsl = {{ $isWsl }}
  archEnv = {{ $archEnv | quote }} # "wsl", "native", "" (if not Arch)
  shell = {{ $shell | quote }} # Default shell

{{/* ========================================== */}}
{{/* Platform-Specific Configurations          */}}
{{/* ========================================== */}}

{{- if $isWsl }}
# WSL2: Use Windows 1Password CLI via interop
[onepassword]
command = "op.exe"
{{- end }}

{
  "$schema": "https://raw.githubusercontent.com/earendil-works/pi-mono/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "{{ .name }}",
  "vars": {
    "mono25": "{{ .c.mono25 }}",
    "mono24": "{{ .c.mono24 }}",
    "mono23": "{{ .c.mono23 }}",
    "mono22": "{{ .c.mono22 }}",
    "text": "{{ .c.text }}",
    "mono20": "{{ .c.mono20 }}",
    "subtext1": "{{ .c.subtext1 }}",
    "mono18": "{{ .c.mono18 }}",
    "subtext0": "{{ .c.subtext0 }}",
    "overlay2": "{{ .c.overlay2 }}",
    "overlay1": "{{ .c.overlay1 }}",
    "mono12": "{{ .c.mono12 }}",
    "overlay0": "{{ .c.overlay0 }}",
    "surface2": "{{ .c.surface2 }}",
    "surface1": "{{ .c.surface1 }}",
    "surface0": "{{ .c.surface0 }}",
    "mono04": "{{ .c.mono04 }}",
    "base": "{{ .c.base }}",
    "mantle": "{{ .c.mantle }}",
    "acc08": "{{ .c.acc08 }}",
    "acc07": "{{ .c.acc07 }}",
    "acc05": "{{ .c.acc05 }}",
    "acc04": "{{ .c.acc04 }}",
    "accDim07": "{{ .c.accDim07 }}",
    "accDim05": "{{ .c.accDim05 }}",
    "red": "{{ .c.red }}",
    "green": "{{ .c.green }}",
    "peach": "{{ .c.peach }}",
    "blue": "{{ .c.blue }}",
    "mauve": "{{ .c.mauve }}",
    "sapphire": "{{ .c.sapphire }}",
    "flamingo": "{{ .c.flamingo }}"
  },
  "colors": {
    "accent": "acc04",
    "border": "surface1",
    "borderAccent": "acc04",
    "borderMuted": "surface0",
    "success": "green",
    "error": "red",
    "warning": "flamingo",
    "muted": "overlay1",
    "dim": "overlay0",
    "text": "text",
    "thinkingText": "overlay1",
    "selectedBg": "mono04",
    "userMessageBg": "base",
    "userMessageText": "text",
    "customMessageBg": "mantle",
    "customMessageText": "text",
    "customMessageLabel": "accDim07",
    "toolPendingBg": "mantle",
    "toolSuccessBg": "base",
    "toolErrorBg": "{{ .c.mixRed10 }}",
    "toolTitle": "acc07",
    "toolOutput": "text",
    "mdHeading": "acc08",
    "mdLink": "accDim05",
    "mdLinkUrl": "subtext1",
    "mdCode": "subtext1",
    "mdCodeBlock": "overlay2",
    "mdCodeBlockBorder": "overlay1",
    "mdQuote": "overlay2",
    "mdQuoteBorder": "surface2",
    "mdHr": "surface2",
    "mdListBullet": "subtext0",
    "toolDiffAdded": "green",
    "toolDiffRemoved": "red",
    "toolDiffContext": "subtext1",
    "syntaxComment": "mono12",
    "syntaxKeyword": "mono25",
    "syntaxFunction": "mono22",
    "syntaxVariable": "subtext0",
    "syntaxString": "overlay1",
    "syntaxNumber": "overlay2",
    "syntaxType": "mono23",
    "syntaxOperator": "text",
    "syntaxPunctuation": "text",
    "thinkingOff": "surface1",
    "thinkingMinimal": "overlay0",
    "thinkingLow": "overlay1",
    "thinkingMedium": "acc04",
    "thinkingHigh": "acc07",
    "thinkingXhigh": "acc08",
    "bashMode": "flamingo"
  },
  "export": {
    "pageBg": "mantle",
    "cardBg": "base",
    "infoBg": "mono04"
  }
}

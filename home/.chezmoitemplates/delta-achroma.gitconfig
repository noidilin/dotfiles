[delta "{{ .name }}"]
	blame-palette = "{{ .c.base }} {{ .c.mantle }} {{ .c.crust }} {{ .c.surface0 }} {{ .c.surface1 }}"
	commit-decoration-style = box ul
{{- if .mode }}
	{{ .mode }} = true
{{- end }}
	file-decoration-style = "{{ .c.text }}"
	file-style = "{{ .c.text }}"
	hunk-header-decoration-style = box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "{{ .c.subtext0 }}"
	hunk-header-style = file line-number syntax
	line-numbers = true
	line-numbers-left-style = "{{ .c.overlay0 }}"
	line-numbers-minus-style = bold "{{ .c.red }}"
	line-numbers-plus-style = bold "{{ .c.green }}"
	line-numbers-right-style = "{{ .c.overlay0 }}"
	line-numbers-zero-style = "{{ .c.overlay0 }}"
	minus-emph-style = bold syntax "{{ .c.mixRed25 }}"
	minus-style = syntax "{{ .c.mixRed10 }}"
	plus-emph-style = bold syntax "{{ .c.mixGreen25 }}"
	plus-style = syntax "{{ .c.mixGreen10 }}"
	map-styles = \
		bold purple => syntax "{{ .c.mixMauve25 }}", \
		bold blue => syntax "{{ .c.mixBlue25 }}", \
		bold cyan => syntax "{{ .c.mixSky25 }}", \
		bold yellow => syntax "{{ .c.mixPeach25 }}"
	syntax-theme = {{ .syntaxTheme }}

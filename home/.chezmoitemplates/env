{{- /* XDG Base Directory Specification */ -}}
{{- range $key, $pathParts := .env.xdg }}
  {{ $key }}={{ printf "%s/%s" $.chezmoi.homeDir (join "/" $pathParts) | quote }}
{{- end }}

{{- /* Development Tool Directories */ -}}
{{- range $key, $pathParts := .env.dev }}
  {{ $key }}={{ printf "%s/%s" $.chezmoi.homeDir (join "/" $pathParts) | quote }}
{{- end }}

{{- /* Application-Specific Directories */ -}}
{{- range $key, $pathParts := .env.other }}
  {{ $key }}={{ printf "%s/%s" $.chezmoi.homeDir (join "/" $pathParts) | quote }}
{{- end }}

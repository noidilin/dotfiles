themes {
    {{ .name }} {
        text_unselected {
            base "{{ .c.text }}"
            emphasis_0 "{{ .c.acc07 }}"
            emphasis_1 "{{ .c.mono18 }}"
            emphasis_2 "{{ .c.mono14 }}"
            emphasis_3 "{{ .c.mono12 }}"
            background "{{ .c.mantle }}"
        }
        text_selected {
            base "{{ .c.acc07 }}"
            emphasis_0 "{{ .c.acc07 }}"
            emphasis_1 "{{ .c.text }}"
            emphasis_2 "{{ .c.mono18 }}"
            emphasis_3 "{{ .c.mono14 }}"
            background "{{ .c.surface0 }}"
        }
        ribbon_unselected {
            base "{{ .c.mantle }}"
            emphasis_0 "{{ .c.text }}"
            emphasis_1 "{{ .c.acc07 }}"
            emphasis_2 "{{ .c.mono18 }}"
            emphasis_3 "{{ .c.mono14 }}"
            background "{{ .c.mono10 }}"
        }
        ribbon_selected {
            base "{{ .c.mantle }}"
            emphasis_0 "{{ .c.acc07 }}"
            emphasis_1 "{{ .c.text }}"
            emphasis_2 "{{ .c.mono18 }}"
            emphasis_3 "{{ .c.mono14 }}"
            background "{{ .ink.ribbonSelectedBg }}"
        }
        table_title {
            base "{{ .c.acc07 }}"
            emphasis_0 "{{ .c.acc07 }}"
            emphasis_1 "{{ .c.text }}"
            emphasis_2 "{{ .c.mono18 }}"
            emphasis_3 "{{ .c.mono14 }}"
            background "{{ .c.mantle }}"
        }
        table_cell_unselected {
            base "{{ .c.text }}"
            emphasis_0 "{{ .c.acc07 }}"
            emphasis_1 "{{ .c.mono18 }}"
            emphasis_2 "{{ .c.mono14 }}"
            emphasis_3 "{{ .c.mono12 }}"
            background "{{ .c.mantle }}"
        }
        table_cell_selected {
            base "{{ .c.acc07 }}"
            emphasis_0 "{{ .c.acc07 }}"
            emphasis_1 "{{ .c.text }}"
            emphasis_2 "{{ .c.mono18 }}"
            emphasis_3 "{{ .c.mono14 }}"
            background "{{ .c.surface0 }}"
        }
        list_unselected {
            base "{{ .c.text }}"
            emphasis_0 "{{ .c.acc07 }}"
            emphasis_1 "{{ .c.mono18 }}"
            emphasis_2 "{{ .c.mono14 }}"
            emphasis_3 "{{ .c.mono12 }}"
            background "{{ .c.mantle }}"
        }
        list_selected {
            base "{{ .c.acc07 }}"
            emphasis_0 "{{ .c.acc07 }}"
            emphasis_1 "{{ .c.text }}"
            emphasis_2 "{{ .c.mono18 }}"
            emphasis_3 "{{ .c.mono14 }}"
            background "{{ .c.surface0 }}"
        }
        frame_unselected {
            base "{{ .ink.frameUnselectedBase }}"
            emphasis_0 "{{ .c.mono10 }}"
            emphasis_1 "{{ .c.mono12 }}"
            emphasis_2 "{{ .c.mono14 }}"
            emphasis_3 "{{ .c.mono18 }}"
        }
        frame_selected {
            base "{{ .c.mono14 }}"
            emphasis_0 "{{ .c.mono18 }}"
            emphasis_1 "{{ .c.text }}"
            emphasis_2 "{{ .c.acc07 }}"
            emphasis_3 "{{ .c.mono12 }}"
        }
        frame_highlight {
            base "{{ .c.mono18 }}"
            emphasis_0 "{{ .c.text }}"
            emphasis_1 "{{ .c.acc07 }}"
            emphasis_2 "{{ .c.mono14 }}"
            emphasis_3 "{{ .c.mono12 }}"
        }
        exit_code_success {
            base "{{ .c.mono18 }}"
            emphasis_0 "{{ .c.mono18 }}"
            emphasis_1 "{{ .c.mono18 }}"
            emphasis_2 "{{ .c.mono18 }}"
            emphasis_3 "{{ .c.mono18 }}"
        }
        exit_code_error {
            base "{{ .c.red }}"
            emphasis_0 "{{ .c.red }}"
            emphasis_1 "{{ .c.red }}"
            emphasis_2 "{{ .c.red }}"
            emphasis_3 "{{ .c.red }}"
        }
    }
}

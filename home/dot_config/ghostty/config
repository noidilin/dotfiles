command = /opt/homebrew/bin/nu
env = XDG_CONFIG_HOME=/Users/noid/.config
env = TERMINAL=ghostty
quit-after-last-window-closed = true

font-family = "CommitMono Nerd Font Mono"
font-family = "Sarasa Mono TC"
font-size = 14
adjust-cell-height = 30%
adjust-underline-position = -2
adjust-underline-thickness = 1
adjust-box-thickness = 2

theme = dark:achroma,light:achroma-light

cursor-style = bar
cursor-style-blink = true
adjust-cursor-thickness = 4
unfocused-split-opacity = 0.80

window-decoration = auto
macos-titlebar-style = hidden
macos-window-buttons = hidden
window-padding-x = 6
window-padding-y = 8
window-padding-balance = false
confirm-close-surface = false
mouse-hide-while-typing = true
scrollback-limit = 50000000

keybind = ctrl+shift+v=paste_from_clipboard
keybind = f3=toggle_command_palette
keybind = f11=toggle_fullscreen
keybind = f12=inspector:toggle
# Send Kitty keyboard protocol encodings so Zellij can distinguish these
# from plain Tab / Shift-Tab and match `bind "Ctrl Tab"` below.
keybind = ctrl+tab=csi:9;5u
keybind = ctrl+shift+tab=csi:9;6u
# Ctrl-, likewise has no legacy encoding. Zellij negotiates the protocol and
# would get this anyway; the explicit forward is what makes it reach herdr,
# whose `goto` action is bound to ctrl+comma. Needed in OmniWM's quake
# terminal too -- that surface loads this file via libghostty's
# ghostty_config_load_default_files.
keybind = ctrl+comma=csi:44;5u
keybind = shift+page_up=scroll_page_fractional:-0.5
keybind = shift+page_down=scroll_page_fractional:0.5

background-opacity = 1.00

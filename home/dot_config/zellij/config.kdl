keybinds clear-defaults=true {
    locked {
        bind "Ctrl q" { SwitchToMode "Normal"; }

        // Ctrl-, has no legacy encoding, so it only arrives as the kitty
        // keyboard CSI 44;5u -- fine here because Zellij pushes `CSI > 1 u`
        // on startup, and ghostty/config forwards the chord explicitly for
        // hosts that do not negotiate the protocol (herdr).
        bind "Ctrl ," {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
        }

        bind "Ctrl Tab" { GoToNextTab; }
        bind "Ctrl Shift Tab" { GoToPreviousTab; }
        bind "Ctrl h" {
            MessagePlugin "file:/Users/noid/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "left";
            }
        }
        bind "Ctrl j" {
            MessagePlugin "file:/Users/noid/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "down";
            }
        }
        bind "Ctrl k" {
            MessagePlugin "file:/Users/noid/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "up";
            }
        }
        bind "Ctrl l" {
            MessagePlugin "file:/Users/noid/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "right";
            }
        }
    }

    normal {
        bind "Ctrl q" { Write 17; SwitchToMode "Locked"; }
        bind "Esc" "Enter" { SwitchToMode "Locked"; }

        bind "-" { NewPane "Down"; SwitchToMode "Locked"; }
        bind "\\" { NewPane "Right"; SwitchToMode "Locked"; }

        bind "x" { CloseFocus; SwitchToMode "Locked"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Locked"; }
        bind "!" { BreakPane; SwitchToMode "Locked"; }

        bind "f" { TogglePaneEmbedOrFloating; ShowFloatingPanes; SwitchToMode "Locked"; }
        bind "a" { ToggleFloatingPanes; SwitchToMode "Locked"; }
        bind "S" { NewPane "stacked"; SwitchToMode "Locked"; }
        bind "P" { TogglePanePinned; SwitchToMode "Locked"; }

        bind "g" {
            Run "/bin/sh" "-lc" "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/zellij/bin/zj-toggle-scratch\"" {
                floating true
                close_on_exit true
                width "1"
                height "1"
                x "100%"
                y "100%"
            }
            SwitchToMode "Locked"
        }

        bind "t" {
            Run "/bin/sh" "-lc" "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/zellij/bin/zj-todo\"" {
                name "todo"
                floating true
                close_on_exit true
                width "95%"
                height "95%"
                x "2.5%"
                y "2.5%"
            }
            SwitchToMode "Locked"
        }

        bind "H" { Resize "Increase Left"; SwitchToMode "Locked"; }
        bind "J" { Resize "Increase Down"; SwitchToMode "Locked"; }
        bind "K" { Resize "Increase Up"; SwitchToMode "Locked"; }
        bind "L" { Resize "Increase Right"; SwitchToMode "Locked"; }

        bind "c" {
            Run "/bin/sh" "-lc" "zellij action new-tab --cwd \"$PWD\" -- /opt/homebrew/bin/nu" {
                floating true
                close_on_exit true
                width "1"
                height "1"
                x "100%"
                y "100%"
            }
            SwitchToMode "Locked"
        }
        bind "&" { CloseTab; SwitchToMode "Locked"; }
        bind "<" { MoveTab "Left"; SwitchToMode "Locked"; }
        bind ">" { MoveTab "Right"; SwitchToMode "Locked"; }
        bind "1" { GoToTab 1; SwitchToMode "Locked"; }
        bind "2" { GoToTab 2; SwitchToMode "Locked"; }
        bind "3" { GoToTab 3; SwitchToMode "Locked"; }
        bind "4" { GoToTab 4; SwitchToMode "Locked"; }
        bind "5" { GoToTab 5; SwitchToMode "Locked"; }
        bind "6" { GoToTab 6; SwitchToMode "Locked"; }
        bind "7" { GoToTab 7; SwitchToMode "Locked"; }
        bind "8" { GoToTab 8; SwitchToMode "Locked"; }
        bind "9" { GoToTab 9; SwitchToMode "Locked"; }

        bind "m" { SwitchToMode "Move"; }
        bind "s" { SwitchToMode "Resize"; }
        bind "v" { SwitchToMode "Scroll"; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "w" { SwitchToMode "Session"; }
    }

    resize {
        bind "h" "Left" { Resize "Increase Left"; }
        bind "j" "Down" { Resize "Increase Down"; }
        bind "k" "Up" { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
        bind "Esc" "Enter" "q" { SwitchToMode "Locked"; }
    }

    move {
        bind "h" "j" "Left" "Down" { MoveTab "Left"; }
        bind "k" "l" "Up" "Right" { MoveTab "Right"; }
        bind "Esc" "Enter" "q" { SwitchToMode "Locked"; }
    }

    scroll {
        bind "e" { EditScrollback; SwitchToMode "Locked"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "J" { PageScrollDown; }
        bind "K" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "D" { PageScrollDown; }
        bind "U" { PageScrollUp; }
        bind "Home" { ScrollToTop; }
        bind "End" { ScrollToBottom; }
        bind "/" "f" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "Esc" "Enter" "q" { SwitchToMode "Locked"; }
    }

    search {
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "n" { Search "down"; }
        bind "p" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "Esc" "Enter" "q" { SwitchToMode "Locked"; }
    }

    entersearch {
        bind "Enter" { SwitchToMode "Search"; }
        bind "Esc" "Ctrl c" { SwitchToMode "Locked"; }
    }

    session {
        bind "o" "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Locked"
        }
        bind "p" {
            Run "/bin/sh" "-lc" "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/zellij/bin/zj-switch-project\"" {
                floating true
                close_on_exit true
                width "1"
                height "1"
                x "100%"
                y "100%"
            }
            SwitchToMode "Locked"
        }
        bind "h" {
            Run "/bin/sh" "-lc" "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/zellij/bin/zj-switch-session-relative\" prev" {
                floating true
                close_on_exit true
                width "1"
                height "1"
                x "100%"
                y "100%"
            }
            SwitchToMode "Locked"
        }
        bind "l" {
            Run "/bin/sh" "-lc" "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/zellij/bin/zj-switch-session-relative\" next" {
                floating true
                close_on_exit true
                width "1"
                height "1"
                x "100%"
                y "100%"
            }
            SwitchToMode "Locked"
        }
        bind "c" {
            LaunchOrFocusPlugin "configuration" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Locked"
        }
        bind "P" {
            LaunchOrFocusPlugin "plugin-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Locked"
        }
        bind "a" {
            LaunchOrFocusPlugin "about" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Locked"
        }
        bind "s" {
            LaunchOrFocusPlugin "zellij:share" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Locked"
        }
        bind "L" {
            LaunchOrFocusPlugin "zellij:layout-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Locked"
        }
        bind "d" { Detach; }
        bind "Esc" "Enter" "q" { SwitchToMode "Locked"; }
    }

    shared_except "locked" {
        bind "Ctrl Tab" { GoToNextTab; }
        bind "Ctrl Shift Tab" { GoToPreviousTab; }
        bind "Ctrl h" {
            MessagePlugin "file:/Users/noid/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "left";
            }
        }
        bind "Ctrl j" {
            MessagePlugin "file:/Users/noid/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "down";
            }
        }
        bind "Ctrl k" {
            MessagePlugin "file:/Users/noid/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "up";
            }
        }
        bind "Ctrl l" {
            MessagePlugin "file:/Users/noid/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "right";
            }
        }
    }
}

plugins {
    zjstatus-bar location="file:/Users/noid/.config/zellij/plugins/zjstatus.wasm" {
        format_left "{mode}#[fg=8]{session} #[fg=8]local#[fg=8,bold] | {tabs}"
        format_center ""
        format_right "{command_worktree}#[fg=8,bold] 󰍛 {command_memory} #[fg=8]{command_battery} "
        format_space ""
        format_precedence "lrc"
        format_hide_on_overlength "true"

        border_enabled "false"
        border_char "─"
        border_format "#[fg=8]{char}"
        border_position "bottom"

        mode_normal "#[fg=0,bold] #[fg=7,bg=0,bold] lead#[fg=0] "
        mode_locked "#[fg=8,bold] #[fg=15,bg=8,bold] noid#[fg=8] "
        mode_resize "#[fg=0,bold] #[fg=7,bg=0,bold]󰊓 resize#[fg=0] "
        mode_move "#[fg=0,bold] #[fg=7,bg=0,bold]󰆾 move#[fg=0] "
        mode_scroll "#[fg=0,bold] #[fg=7,bg=0,bold]󰈙 view#[fg=0] "
        mode_enter_search "#[fg=0,bold] #[fg=7,bg=0,bold]󰍉 search#[fg=0] "
        mode_search "#[fg=0,bold] #[fg=7,bg=0,bold]󰍉 search#[fg=0] "
        mode_session "#[fg=0,bold] #[fg=7,bg=0,bold] mux#[fg=0] "
        mode_tab "#[fg=0,bold] #[fg=7,bg=0,bold] tab#[fg=0] "
        mode_pane "#[fg=0,bold] #[fg=7,bg=0,bold] pane#[fg=0] "
        mode_tmux "#[fg=0,bold] #[fg=7,bg=0,bold] lead#[fg=0] "

        tab_normal "#[fg=0]  #[fg=0,bold]{name} "
        tab_active "#[bold]  #[bold]{name}{fullscreen_indicator}{floating_indicator} "
        tab_separator "#[fg=8]|"
        tab_display_count "9"
        tab_truncate_start_format "#[fg=0]‹ +{count} "
        tab_truncate_end_format "#[fg=0] +{count} › "
        tab_fullscreen_indicator " "
        tab_floating_indicator " ⬚"

        command_worktree_command "/Users/noid/.config/zellij/bin/zjstatus-worktree"
        command_worktree_cwd "{focused_pane_cwd}"
        command_worktree_format "#[fg=8,bold] {stdout} "
        command_worktree_interval "10"
        command_worktree_rendermode "static"
        command_worktree_hideonemptystdout "true"

        command_memory_command "/Users/noid/.config/zellij/bin/zjstatus-memory"
        command_memory_format "#[fg=8,bold]{stdout}"
        command_memory_interval "30"
        command_memory_rendermode "static"

        command_battery_command "/Users/noid/.config/zellij/bin/zjstatus-battery"
        command_battery_format "#[fg=8,bold]{stdout}"
        command_battery_interval "60"
        command_battery_rendermode "static"
        command_battery_hideonemptystdout "true"
    }

    tab-bar location="zellij:tab-bar"
    status-bar location="zellij:status-bar"
    compact-bar location="zellij:compact-bar"
    session-manager location="zellij:session-manager"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
    configuration location="zellij:configuration"
    plugin-manager location="zellij:plugin-manager"
    about location="zellij:about"
}

load_plugins {
    "zellij:link"
}

theme "achroma"
theme_dark "achroma"
theme_light "achroma-light"
theme_dir "/Users/noid/.config/zellij/themes"
default_mode "locked"
default_layout "noid"
default_shell "/opt/homebrew/bin/nu"
pane_frames false
auto_layout true
mouse_mode true
copy_on_select true
copy_clipboard "system"
scrollback_editor "/opt/homebrew/bin/nvim"
scroll_buffer_size 5000
session_serialization true
serialize_pane_viewport false
styled_underlines true
support_kitty_keyboard_protocol true
show_release_notes false

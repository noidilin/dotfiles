#!/bin/sh
set -eu

worktree_name_from_dir() {
  name=${1#*.}
  [ -n "$name" ] && [ "$name" != "$1" ] && printf '%s' "$name"
}

cwd=${1:-${PWD:-}}
[ -n "$cwd" ] || exit 0

if ! command -v git >/dev/null 2>&1; then
  exit 0
fi

if ! git -C "$cwd" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  exit 0
fi

root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || true)
[ -n "$root" ] || root=$cwd
leaf=${root##*/}

if worktree=$(worktree_name_from_dir "$leaf"); then
  printf ' %.25s' "$worktree"
  exit 0
fi

branch=$(git -C "$cwd" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
if [ -n "$branch" ]; then
  printf ' %.25s' "$branch"
  exit 0
fi

commit=$(git -C "$cwd" rev-parse --short HEAD 2>/dev/null || true)
if [ -n "$commit" ]; then
  printf ' %.25s' "$commit"
fi

{{- $d := .color.achroma.dark -}}
{{- $l := .color.achroma.light -}}
export BAT_CONFIG_DIR="${HOME}/.config/bat"
export YAZI_CONFIG_HOME="${HOME}/.config/yazi"

export EDITOR="nvim"
export PAGER="delta"
export CARAPACE_BRIDGES="zsh,fish,bash,inshellisense"
export CC="gcc"

if defaults read -g AppleInterfaceStyle 2>/dev/null | grep -q Dark; then
  export ACHROMA_VARIANT="dark"
else
  export ACHROMA_VARIANT="light"
fi

# delta cannot pick a feature from the terminal background itself; a bare
# (un-prefixed) DELTA_FEATURES value replaces the features from gitconfig.
if [ "$ACHROMA_VARIANT" = "light" ]; then
  export DELTA_FEATURES="achroma-light"
else
  export DELTA_FEATURES="achroma"
fi

if [ "$ACHROMA_VARIANT" = "light" ]; then
  _achroma_suffix="-light"
  export EZA_CONFIG_DIR="${HOME}/.config/eza/achroma-light"
else
  _achroma_suffix=""
  export EZA_CONFIG_DIR="${HOME}/.config/eza/achroma"
fi

export LG_CONFIG_FILE="${HOME}/.config/lazygit/config.yml,${HOME}/.config/lazygit/theme-achroma${_achroma_suffix}.yml"

export GH_DASH_CONFIG="${HOME}/.config/gh-dash/config-achroma${_achroma_suffix}.yml"
unset _achroma_suffix

if command -v vivid >/dev/null 2>&1; then
  if [ "$ACHROMA_VARIANT" = "light" ]; then
    _vivid_theme="${XDG_CONFIG_HOME:-$HOME/.config}/vivid/themes/achroma-light.yml"
  else
    _vivid_theme="${XDG_CONFIG_HOME:-$HOME/.config}/vivid/themes/achroma.yml"
  fi
  if [ -f "$_vivid_theme" ]; then
    export LS_COLORS="$(vivid generate "$_vivid_theme" 2>/dev/null)"
  fi
  unset _vivid_theme
fi

if [ "$ACHROMA_VARIANT" = "light" ]; then
  _fzf_color_theme="--color=fg:{{ $l.subtext0 }},fg+:{{ $l.text }},bg:-1,bg+:-1 --color=hl:{{ $l.acc04 }},hl+:{{ $l.acc07 }},info:{{ $l.surface2 }},marker:{{ $l.accDim02 }} --color=prompt:{{ $l.mono25 }},spinner:{{ $l.accDim00 }},pointer:{{ $l.accDim02 }},header:{{ $l.text }} --color=border:{{ $l.surface0 }},label:{{ $l.text }},query:{{ $l.mono23 }}"
else
  _fzf_color_theme="--color=fg:{{ $d.subtext0 }},fg+:{{ $d.text }},bg:-1,bg+:-1 --color=hl:{{ $d.acc04 }},hl+:{{ $d.acc07 }},info:{{ $d.surface2 }},marker:{{ $d.accDim02 }} --color=prompt:{{ $d.mono25 }},spinner:{{ $d.accDim00 }},pointer:{{ $d.accDim02 }},header:{{ $d.text }} --color=border:{{ $d.surface0 }},label:{{ $d.text }},query:{{ $d.mono23 }}"
fi
export FZF_DEFAULT_OPTS="${_fzf_color_theme}${FZF_DEFAULT_OPTS:+ ${FZF_DEFAULT_OPTS}}"
unset _fzf_color_theme

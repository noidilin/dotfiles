{{- if eq .osId "windows" }}
[[ssh-keys]]
item = "github-win"
vault = "dev"
{{- else if eq .osId "linux-arch" }}
{{-   if eq .archEnv "wsl" }}
[[ssh-keys]]
item = "github-arch"
vault = "dev"
{{-   else }}
[[ssh-keys]]
item = "github-arch"
vault = "dev"
{{-   end }}
{{- else if eq .osId "darwin" }}
[[ssh-keys]]
item = "github-mac"
vault = "dev"
{{- end }}

[[ssh-keys]]
vault = "Private"
account = "HOME"

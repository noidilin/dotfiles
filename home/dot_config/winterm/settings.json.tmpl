            },
            {
                "guid": "{3630a796-aee0-5bbc-a89a-42e85eafcca4}",
                "hidden": false,
                "name": "Ubuntu",
                "source": "Microsoft.WSL"
            },
            {
                "guid": "{a8970d83-2928-51ca-8ceb-dcaa15cf4ed7}",

{{- /* opencode resolves light/dark per color at runtime from the terminal
   background, so this one theme serves both variants. defs carry both
   palettes from .chezmoidata/colors.yml: dark roles keep their names,
   light roles get a "light-" prefix. Light choices follow the wezterm
   ink lessons: borders step to a mid tone (light-mono10), everything
   else mirrors by role. */ -}}
{{- $defs := list -}}
{{- range $k, $v := .color.achroma.dark -}}
{{- $defs = append $defs (printf "%q: %q" $k $v) -}}
{{- end -}}
{{- range $k, $v := .color.achroma.light -}}
{{- $defs = append $defs (printf "%q: %q" (printf "light-%s" $k) $v) -}}
{{- end -}}
{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    {{ $defs | join ",\n    " }}
  },
  "theme": {
    "primary": { "dark": "acc07", "light": "light-acc07" },
    "secondary": { "dark": "mono23", "light": "light-mono23" },
    "accent": { "dark": "acc04", "light": "light-acc04" },
    "error": { "dark": "red", "light": "light-red" },
    "warning": { "dark": "flamingo", "light": "light-flamingo" },
    "success": { "dark": "green", "light": "light-green" },
    "info": { "dark": "#dc8a78", "light": "#8b574c" },
    "text": { "dark": "text", "light": "light-text" },
    "textMuted": { "dark": "overlay1", "light": "light-overlay1" },
    "background": { "dark": "mantle", "light": "light-mantle" },
    "backgroundPanel": { "dark": "mantle", "light": "light-mantle" },
    "backgroundElement": { "dark": "mantle", "light": "light-mantle" },
    "border": { "dark": "surface1", "light": "light-mono10" },
    "borderActive": { "dark": "acc04", "light": "light-acc04" },
    "borderSubtle": { "dark": "surface0", "light": "light-surface1" },
    "diffAdded": { "dark": "green", "light": "light-green" },
    "diffRemoved": { "dark": "red", "light": "light-red" },
    "diffContext": { "dark": "subtext1", "light": "light-subtext1" },
    "diffHunkHeader": { "dark": "subtext1", "light": "light-subtext1" },
    "diffHighlightAdded": { "dark": "green", "light": "light-green" },
    "diffHighlightRemoved": { "dark": "red", "light": "light-red" },
    "diffAddedBg": { "dark": "#1c201c", "light": "light-mixGreen10" },
    "diffRemovedBg": { "dark": "#271717", "light": "light-mixRed10" },
    "diffContextBg": { "dark": "mantle", "light": "light-mantle" },
    "diffLineNumber": { "dark": "base", "light": "light-base" },
    "diffAddedLineNumberBg": { "dark": "#1c201c", "light": "light-mixGreen10" },
    "diffRemovedLineNumberBg": { "dark": "#271717", "light": "light-mixRed10" },
    "markdownText": { "dark": "text", "light": "light-text" },
    "markdownHeading": { "dark": "acc08", "light": "light-acc08" },
    "markdownLink": { "dark": "accDim05", "light": "light-accDim05" },
    "markdownLinkText": { "dark": "subtext1", "light": "light-subtext1" },
    "markdownCode": { "dark": "subtext1", "light": "light-subtext1" },
    "markdownBlockQuote": { "dark": "overlay2", "light": "light-overlay2" },
    "markdownEmph": { "dark": "mono23", "light": "light-mono23" },
    "markdownStrong": { "dark": "mono23", "light": "light-mono23" },
    "markdownHorizontalRule": { "dark": "blue", "light": "light-blue" },
    "markdownListItem": { "dark": "subtext0", "light": "light-subtext0" },
    "markdownListEnumeration": { "dark": "subtext0", "light": "light-subtext0" },
    "markdownImage": { "dark": "accDim05", "light": "light-accDim05" },
    "markdownImageText": { "dark": "subtext1", "light": "light-subtext1" },
    "markdownCodeBlock": { "dark": "overlay2", "light": "light-overlay2" },
    "syntaxComment": { "dark": "mono12", "light": "light-mono12" },
    "syntaxKeyword": { "dark": "mono25", "light": "light-mono25" },
    "syntaxFunction": { "dark": "mono22", "light": "light-mono22" },
    "syntaxVariable": { "dark": "subtext0", "light": "light-subtext0" },
    "syntaxString": { "dark": "overlay1", "light": "light-overlay1" },
    "syntaxNumber": { "dark": "overlay2", "light": "light-overlay2" },
    "syntaxType": { "dark": "mono23", "light": "light-mono23" },
    "syntaxOperator": { "dark": "text", "light": "light-text" },
    "syntaxPunctuation": { "dark": "text", "light": "light-text" },
    "inputBackground": { "dark": "mantle", "light": "light-mantle" },
    "InputBorder": { "dark": "surface1", "light": "light-mono10" },
    "InputBorderActive": { "dark": "overlay0", "light": "light-overlay1" },
    "inputPrompt": { "dark": "accDim07", "light": "light-accDim07" },
    "inputCursor": { "dark": "accDim07", "light": "light-accDim07" },
    "inputText": { "dark": "text", "light": "light-text" }
  }
}

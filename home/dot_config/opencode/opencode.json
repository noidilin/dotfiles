{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "plan": {
      "color": "#5d5d5d"
    },
    "build": {
      "color": "#dad5c8"
    }
  },
  "mcp": {
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "oauth": {},
      "enabled": true,
    },
    "clickup": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.clickup.com/mcp"
      ],
      "enabled": true,
    },
  },
  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      }
    }
  }
}

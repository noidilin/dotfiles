# =============================================================================
# Mise Runtime Version Manager Configuration
# =============================================================================
# Generated from: .chezmoidata.toml [dev.mise.*]
# Modify .chezmoidata.toml, then run: chezmoi apply
# =============================================================================

[tools]
{{- range $name, $config := .dev.mise.tools }}
{{- if eq $name "node" }}
node = { version = "{{ $config.version }}", postinstall = "{{ $config.postinstall }}" }
{{- else if eq $name "rust" }}
{{- if eq $.chezmoi.os "windows" }}
"rust".version = "{{ $config.windows.version }}"
"rust".profile = "{{ $config.windows.profile }}"
{{- else if eq $.chezmoi.os "linux" }}
"rust".version = "{{ $config.linux.version }}"
"rust".profile = "{{ $config.linux.profile }}"
{{- end }}
{{- else if kindIs "string" $config }}
{{ $name }} = "{{ $config }}"
{{- else }}
# Complex config for {{ $name }}
{{ $name }} = {{ $config | toJson }}
{{- end }}
{{- end }}

[settings]
{{- range $key, $value := .dev.mise.settings }}
{{- if kindIs "bool" $value }}
{{ $key }} = {{ $value }}
{{- else if kindIs "string" $value }}
{{ $key }} = "{{ $value }}"
{{- else }}
{{ $key }} = {{ $value }}
{{- end }}
{{- end }}

# =============================================================================
# Mise Runtime Version Manager Configuration
# =============================================================================
# Generated from: .chezmoidata/mise.yml
# Modify .chezmoidata/mise.yml, then run: chezmoi apply
# =============================================================================

[tools]
{{- range $name, $config := .mise.tools }}
{{-   if eq $name "node" }}
node = { version = "{{ $config.version }}", postinstall = "{{ $config.postinstall }}" }
{{-   else if eq $name "rust" }}
{{-     if eq $.chezmoi.os "windows" }}
rust = { version = "{{ $config.windows.version }}", profile = "{{ $config.windows.profile }}" }
{{-     else if eq $.chezmoi.os "linux" }}
rust = { version = "{{ $config.linux.version }}", profile = "{{ $config.linux.profile }}" }
{{-     else if eq $.chezmoi.os "darwin" }}
rust = { version = "{{ $config.darwin.version }}", profile = "{{ $config.darwin.profile }}" }
{{-     end }}
{{-   else if kindIs "string" $config }}
{{ $name }} = "{{ $config }}"
{{-   else if kindIs "map" $config }}
    {{/* Handle future tools with inline table format */}}
{{-     if and $config.version (not $config.windows) (not $config.linux) }}
{{ $name }} = { version = "{{ $config.version }}"{{- if $config.profile }}, profile = "{{ $config.profile }}"{{- end }}{{- if $config.postinstall }}, postinstall = "{{ $config.postinstall }}"{{- end }} }
{{-     end }}
{{-   end }}
{{- end }}

[settings]
{{- range $key, $value := .mise.settings }}
{{-   if kindIs "bool" $value }}
{{ $key }} = {{ $value }}
{{-   else if kindIs "string" $value }}
{{ $key }} = "{{ $value }}"
{{-   else }}
{{ $key }} = {{ $value }}
{{-   end }}
{{- end }}

# =============================================================================
# Environment Configuration
# =============================================================================
# Add tool bin directories to PATH when mise is activated in the shell.
# Scripts should continue using `mise exec --` pattern.

[[env]]
_.path = [
  "{{`{{env.PNPM_HOME}}`}}",
  "{{`{{env.BUN_INSTALL_BIN}}`}}",
  "{{`{{env.CARGO_HOME}}`}}/bin",
  "{{`{{env.GOBIN}}`}}",
  "{{`{{env.UV_TOOL_BIN_DIR}}`}}"
]

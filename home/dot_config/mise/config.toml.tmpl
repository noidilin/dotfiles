# =============================================================================
# Mise Runtime Version Manager Configuration
# =============================================================================
# Generated from: .chezmoidata/mise.yml
# Modify .chezmoidata/mise.yml, then run: chezmoi apply
# =============================================================================

[tools]
{{- range $name, $config := .mise.tools }}
{{-   if eq $name "node" }}
node = { version = "{{ $config.version }}", postinstall = "{{ $config.postinstall }}" }
{{-   else if eq $name "rust" }}
{{-     if eq $.chezmoi.os "windows" }}
rust = { version = "{{ $config.windows.version }}", profile = "{{ $config.windows.profile }}" }
{{-     else if eq $.chezmoi.os "linux" }}
rust = { version = "{{ $config.linux.version }}", profile = "{{ $config.linux.profile }}" }
{{-     else if eq $.chezmoi.os "darwin" }}
rust = { version = "{{ $config.darwin.version }}", profile = "{{ $config.darwin.profile }}" }
{{-     end }}
{{-   else if kindIs "string" $config }}
{{ $name }} = "{{ $config }}"
{{-   else if kindIs "map" $config }}
    {{/* Handle future tools with inline table format */}}
{{-     if and $config.version (not $config.windows) (not $config.linux) }}
{{ $name }} = { version = "{{ $config.version }}"{{- if $config.profile }}, profile = "{{ $config.profile }}"{{- end }}{{- if $config.postinstall }}, postinstall = "{{ $config.postinstall }}"{{- end }} }
{{-     end }}
{{-   end }}
{{- end }}

[settings]
{{- range $key, $value := .mise.settings }}
{{-   if kindIs "bool" $value }}
{{ $key }} = {{ $value }}
{{-   else if kindIs "string" $value }}
{{ $key }} = "{{ $value }}"
{{-   else }}
{{ $key }} = {{ $value }}
{{-   end }}
{{- end }}

# =============================================================================
# Environment Configuration
# =============================================================================
# Environment variables are set using mise's [[env]] section for cross-shell
# compatibility (bash/zsh/fish/nushell). These vars are active when mise is
# activated in the shell.
#
# Paths are generated from .chezmoidata/env.yml using the same template as
# chezmoi scriptEnv to maintain single source of truth.
#
# Absolute paths (using chezmoi.homeDir) are used for maximum cross-platform
# compatibility, especially on Windows where tilde expansion may not work
# consistently across all contexts.

[[env]]
{{- /* XDG Base Directory Specification */ -}}
{{- range $key, $pathParts := .env.xdg }}
  {{ $key }} = {{ printf "%s/%s" $.chezmoi.homeDir (join "/" $pathParts) | quote }}
{{- end }}

{{- /* Development Tool Directories */ -}}
{{- range $key, $pathParts := .env.dev }}
  {{ $key }} = {{ printf "%s/%s" $.chezmoi.homeDir (join "/" $pathParts) | quote }}
{{- end }}

{{- /* Application-Specific Directories */ -}}
{{- range $key, $pathParts := .env.other }}
  {{ $key }} = {{ printf "%s/%s" $.chezmoi.homeDir (join "/" $pathParts) | quote }}
{{- end }}

_.path = [
{{- range .env.path }}
{{-   $varName := . }}
{{-   $pathParts := index $.env.dev $varName }}
{{-   if not $pathParts }}
{{-     $pathParts = index $.env.xdg $varName }}
{{-   end }}
{{-   if $pathParts }}
{{-     if eq $varName "CARGO_HOME" }}
  {{ printf "%s/%s/bin" $.chezmoi.homeDir (join "/" $pathParts) | quote }},
{{-     else }}
  {{ printf "%s/%s" $.chezmoi.homeDir (join "/" $pathParts) | quote }},
{{-     end }}
{{-   end }}
{{- end }}
]

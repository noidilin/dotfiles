$env.FZF_DEFAULT_COMMAND = "fd --hidden --strip-cwd-prefix --exclude .git"
$env.FZF_CTRL_T_COMMAND = "fd --type file --hidden --strip-cwd-prefix --exclude .git"
$env.FZF_ALT_C_COMMAND = "fd --type directory --hidden --strip-cwd-prefix --exclude .git"

{{- $d := .color.achroma.dark }}
{{- $l := .color.achroma.light }}
let fzf_colors = if ($env.ACHROMA_VARIANT? | default 'dark') == 'light' {
    [
        "--color=fg:{{ $l.subtext0 }},fg+:{{ $l.text }},bg:-1,bg+:-1"
        "--color=hl:{{ $l.acc04 }},hl+:{{ $l.acc07 }},info:{{ $l.surface2 }},marker:{{ $l.accDim02 }}"
        "--color=prompt:{{ $l.mono25 }},spinner:{{ $l.accDim00 }},pointer:{{ $l.accDim02 }},header:{{ $l.text }}"
        "--color=border:{{ $l.surface0 }},label:{{ $l.text }},query:{{ $l.mono23 }}"
    ]
} else {
    [
        "--color=fg:{{ $d.subtext0 }},fg+:{{ $d.text }},bg:-1,bg+:-1"
        "--color=hl:{{ $d.acc04 }},hl+:{{ $d.acc07 }},info:{{ $d.surface2 }},marker:{{ $d.accDim02 }}"
        "--color=prompt:{{ $d.mono25 }},spinner:{{ $d.accDim00 }},pointer:{{ $d.accDim02 }},header:{{ $d.text }}"
        "--color=border:{{ $d.surface0 }},label:{{ $d.text }},query:{{ $d.mono23 }}"
    ]
}
$env.FZF_DEFAULT_OPTS = ($fzf_colors ++ [
    "--padding='2' --margin='2' --layout=reverse --info='right'"
    "--prompt='> ' --marker='>' --pointer='◆' --separator='─' --scrollbar='│'"
    "--border='rounded' --border-label='fzf' --border-label-pos='0'"
    "--cycle --scroll-off=5"
    "--preview-window=right,60%,border-left"
    "--bind ctrl-u:preview-half-page-up"
    "--bind ctrl-d:preview-half-page-down"
    "--bind ctrl-f:preview-page-down"
    "--bind ctrl-b:preview-page-up"
    "--bind ctrl-g:preview-top"
    "--bind ctrl-h:preview-bottom"
    "--bind alt-w:toggle-preview-wrap"
    "--bind ctrl-e:toggle-preview"
]) | str join " "

$env.FZF_CTRL_T_OPTS = "--height 80% --preview 'bat -n --color=always --line-range=:500 {}'"
$env.FZF_ALT_C_OPTS = "--height 80% --preview 'eza --tree --level=2 --color=always {} '"

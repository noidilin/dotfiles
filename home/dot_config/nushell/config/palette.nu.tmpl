export def main [] {
  let dark = {
{{- range $k, $v := .color.achroma.dark }}
    {{ $k }}: '{{ $v }}'
{{- end }}
  }
  let light = {
{{- range $k, $v := .color.achroma.light }}
    {{ $k }}: '{{ $v }}'
{{- end }}
  }
  let p = if ($env.ACHROMA_VARIANT? | default 'dark') == 'light' { $light } else { $dark }

  return {
    binary: $p.subtext1
    block: $p.subtext0
    cell-path: $p.mono18
    closure: $p.mono20
    custom: $p.acc05
    duration: $p.overlay1
    float: $p.subtext0
    glob: $p.mono18
    int: $p.overlay2
    list: $p.mono20
    nothing: $p.overlay1
    range: $p.acc02
    record: $p.mono20
    string: $p.overlay2

    bool: {|| if $in { $p.subtext0 } else { $p.flamingo } }

    date: {|| (date now) - $in |
        if $in < 1hr {
            { fg: $p.text attr: b }
        } else if $in < 6hr {
            $p.text
        } else if $in < 1day {
            $p.subtext1
        } else if $in < 3day {
            $p.subtext0
        } else if $in < 1wk {
            { fg: $p.overlay2 attr: b }
        } else if $in < 6wk {
            $p.overlay1
        } else if $in < 52wk {
            $p.overlay0
        } else { $p.surface2 }
    }

    filesize: {|e|
        if $e == 0b {
            { fg: $p.overlay1 attr: s }
        } else if $e < 1mb {
            $p.subtext0
        } else {{ "{{" }} fg: $p.mono20 {{ "}}" }}
    }

    shape_and: { fg: $p.subtext1 attr: b }
    shape_binary: { fg: $p.subtext1 attr: b }
    shape_block: { fg: $p.subtext0 attr: b }
    shape_bool: $p.subtext0
    shape_closure: { fg: $p.mono20 attr: b }
    shape_custom: $p.acc05
    shape_datetime: { fg: $p.mono16 }
    shape_directory: $p.mono18
    shape_external: { fg: $p.mono20 attr: i }
    shape_external_resolved: { fg: $p.mono22 attr: b }
    shape_externalarg: $p.mono16
    shape_filepath: $p.mono18
    shape_flag: { fg: $p.mono16 attr: b }
    shape_float: { fg: $p.subtext0 }
    shape_garbage: { fg: $p.overlay1 attr: biu }
    shape_glob_interpolation: { fg: $p.mono18 attr: b }
    shape_globpattern: { fg: $p.mono18 attr: b }
    shape_int: { fg: $p.overlay2 }
    shape_internalcall: { fg: $p.mono22 attr: b }
    shape_keyword: { fg: $p.subtext1 attr: b }
    shape_list: { fg: $p.mono20 }
    shape_literal: $p.subtext0
    shape_match_pattern: $p.mono24
    shape_matching_brackets: { attr: u }
    shape_nothing: $p.overlay1
    shape_operator: $p.acc02
    shape_or: { fg: $p.subtext1 attr: b }
    shape_pipe: { fg: $p.subtext1 attr: b }
    shape_range: { fg: $p.acc02 attr: b }
    shape_raw_string: { fg: $p.mono22 attr: b }
    shape_record: { fg: $p.mono20 attr: b }
    shape_redirection: { fg: $p.subtext1 attr: b }
    shape_signature: { fg: $p.mono24 attr: b }
    shape_string: $p.overlay2
    shape_string_interpolation: { fg: $p.subtext0 attr: b }
    shape_table: { fg: $p.subtext0 attr: b }
    shape_vardecl: { fg: $p.subtext0 attr: u }
    shape_variable: { fg: $p.subtext1 attr: ui }

    foreground: $p.mono16
    background: $p.mantle
    cursor: $p.subtext0

    empty: $p.surface1
    header: { fg: $p.mono24 attr: b }
    hints: { fg: $p.surface2 attr: i }
    leading_trailing_space_bg: { attr: n }
    row_index: { fg: $p.mono22 attr: b }
    search_result: { fg: $p.subtext0 bg: $p.mono10 attr: b }
    separator: $p.surface1
  }
}

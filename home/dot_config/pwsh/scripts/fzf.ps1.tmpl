{{- $d := .color.achroma.dark -}}
{{- $l := .color.achroma.light -}}
$achromaFzfColors = if ($env:ACHROMA_VARIANT -eq 'light') {
@"
--color=fg:{{ $l.mono18 }},fg+:{{ $l.text }},bg:-1,bg+:-1
--color=hl:{{ $l.acc04 }},hl+:{{ $l.acc07 }},info:{{ $l.mono10 }},marker:{{ $l.acc05 }}
--color=prompt:{{ $l.mono25 }},spinner:{{ $l.acc00 }},pointer:{{ $l.acc02 }},header:{{ $l.text }}
--color=border:{{ $l.surface0 }},label:{{ $l.text }},query:{{ $l.mono24 }}
"@
} else {
@"
--color=fg:{{ $d.mono18 }},fg+:{{ $d.text }},bg:-1,bg+:-1
--color=hl:{{ $d.acc04 }},hl+:{{ $d.acc07 }},info:{{ $d.mono10 }},marker:{{ $d.acc05 }}
--color=prompt:{{ $d.mono25 }},spinner:{{ $d.acc00 }},pointer:{{ $d.acc02 }},header:{{ $d.text }}
--color=border:{{ $d.surface0 }},label:{{ $d.text }},query:{{ $d.mono24 }}
"@
}
$env:FZF_DEFAULT_OPTS = @"
$achromaFzfColors
--padding="2" --margin="2" --layout=reverse --info="right"
--prompt="> " --marker=">" --pointer="◆" --separator="─" --scrollbar="│"
--border="rounded" --border-label="fzf" --border-label-pos="0"
--cycle --scroll-off=5
--preview-window=right,60%,border-left
--bind ctrl-u:preview-half-page-up
--bind ctrl-d:preview-half-page-down
--bind ctrl-f:preview-page-down
--bind ctrl-b:preview-page-up
--bind ctrl-g:preview-top
--bind ctrl-h:preview-bottom
--bind alt-w:toggle-preview-wrap
--bind ctrl-e:toggle-preview
"@
Remove-Variable achromaFzfColors

$env:FZF_DEFAULT_COMMAND = "fd --hidden --strip-cwd-prefix --exclude .git"
$env:FZF_CTRL_T_COMMAND = $FZF_DEFAULT_COMMAND
$env:FZF_ALT_C_COMMAND = "fd --type dir --hidden --strip-cwd-prefix --exclude .git"

$preview_path_or_dir = "if (Test-Path -PathType Container '{}') { eza --tree --level=3 --color=always --icons=always '{}'} else { bat -n --color=always --line-range :500 '{}'}"
$env:FZF_CTRL_T_OPTS = "--height 100% --preview 'powershell -Command $preview_path_or_dir'"
$env:FZF_ALT_C_OPTS = "--preview 'eza --tree --level=3 --color=always --icons=always {}'"

Set-PsFzfOption `
  -PSReadlineChordProvider "Ctrl+t" `
  -PSReadlineChordReverseHistory "Ctrl+r" `
  -GitKeyBindings `
  -TabExpansion `
  -EnableAliasFuzzyScoop `
  -EnableAliasFuzzyKillProcess

Set-PSReadLineKeyHandler -Key Tab -ScriptBlock { Invoke-FzfTabCompletion }

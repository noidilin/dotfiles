[".config/nvim"]
type = "git-repo"
url = "git@github.com:noidilin/nvim.git"
refreshPeriod = "168h"

[".config/yazi/flavors/achroma.yazi"]
type = "git-repo"
url = "git@github.com:noidilin/achroma.yazi.git"
refreshPeriod = "168h"

{{- if ne .archEnv "wsl" }}

[".config/wezterm"]
type = "git-repo"
url = "git@github.com:noidilin/wezterm.git"
refreshPeriod = "168h"

[".config/rime"]
type = "archive"
# Avoid gitHubLatestTag here: chezmoi evaluates templates on every status/apply,
# which would hit GitHub even when refreshPeriod has not elapsed.
url = "https://github.com/amzxyz/rime_wanxiang/releases/latest/download/rime-wanxiang-base.zip"
exact = false
stripComponents = 0
refreshPeriod = "168h"
exclude = [
  "README.md",
  "custom/**.md",
  "custom/**.png",
  "custom/**.jpg"
]

{{- end }}

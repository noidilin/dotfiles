[".config/nvim"]
type = "git-repo"
url = "git@github.com:noidilin/nvim.git"
refreshPeriod = "168h"

[".config/yazi/flavors/achroma.yazi"]
type = "git-repo"
url = "git@github.com:noidilin/achroma.yazi.git"
refreshPeriod = "168h"

[".config/wezterm"]
type = "git-repo"
url = "git@github.com:noidilin/wezterm.git"
refreshPeriod = "168h"

[".config/rime"]
type = "archive"
url = {{ gitHubReleaseAssetURL "amzxyz/rime_wanxiang" (gitHubLatestTag "amzxyz/rime_wanxiang").Name "rime-wanxiang-base.zip" | quote }}
exact = false
stripComponents = 0
refreshPeriod = "168h"
exclude = [
  "README.md",
  "custom/**.md",
  "custom/**.png",
  "custom/**.jpg"
]

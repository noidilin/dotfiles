[Typography]
Layout=Vertical
WritingMode="Horizontal top-bottom"
TypographyAwarenessForIM=True
VerticalCommentsAlignRight=False
PagingButtonsStyle=Arrow

[Background]
ImageUrl=
KeepPanelColorWhenHasImage=False
Blur=System
Shadow=True

[Font]
TextFontSize=16
TextFontWeight=400
LabelFontSize=12
LabelFontWeight=400
CommentFontSize=12
CommentFontWeight=400
PreeditFontSize=16
PreeditFontWeight=400

[Font/TextFontFamily]
0=

[Font/LabelFontFamily]
0=

[Font/CommentFontFamily]
0=

[Font/PreeditFontFamily]
0=

[Caret]
Style=Blink
Text=‸

[Highlight]
MarkStyle=None
MarkText=*
HoverBehavior=None

[Size]
OverrideDefault=True
BorderWidth=1
BorderRadius=8
Margin=2
HighlightRadius=8
TopPadding=3
RightPadding=7
BottomPadding=3
LeftPadding=7
LabelTextGap=6
VerticalMinWidth=200
ScrollCellWidth=65
HorizontalDividerWidth=1


#!/bin/bash
# vim: ft=bash

{{- if eq .chezmoi.os "linux" }}
# =============================================================================
# Install Node.js Global Packages (Linux)
# =============================================================================
# This script runs when .chezmoidata.toml changes
# Source: .chezmoidata.toml [dev.node.*]
# Hash trigger: {{ include ".chezmoidata.toml" | sha256sum }}
# =============================================================================

set -euo pipefail

echo "=== Installing Node.js global packages ==="

# Check if mise is installed
if ! command -v mise &>/dev/null; then
    echo "WARNING: mise is not installed yet (skipping node package installation)"
    exit 0
fi

# Check if node is available via mise
if ! mise exec -- node --version &>/dev/null; then
    echo "WARNING: Node.js is not installed via mise yet (skipping)"
    echo "Run 'mise install' to install Node.js first"
    exit 0
fi

node_version=$(mise exec -- node --version)
echo "Node.js version: $node_version"

# Install pnpm global packages
{{- if .dev.node.pnpm }}
echo ""
echo "Installing pnpm global packages..."
{{- range .dev.node.pnpm }}
echo "Installing (pnpm): {{ . }}"
mise exec -- pnpm add -g {{ . }} || echo "Failed to install {{ . }}"
{{- end }}
{{- end }}

# Install bun global packages
{{- if .dev.node.bun }}
echo ""
echo "Installing bun global packages..."
{{- range .dev.node.bun }}
echo "Installing (bun): {{ . }}"
mise exec -- bun add -g {{ . }} || echo "Failed to install {{ . }}"
{{- end }}
{{- end }}

echo ""
echo "Node.js package installation complete!"
{{- end }}

#!/bin/bash
# vim: ft=bash

{{- if eq .chezmoi.os "linux" }}
# =============================================================================
# Install Node.js Global Packages (Linux)
# =============================================================================
# Execution Order: 12 (run_onchange_after_12-*)
# - Runs on every `chezmoi apply` when .chezmoidata.toml changes
# - Installs global npm/pnpm/bun packages via mise
# - Requires mise and Node.js to be installed first
# Source: .chezmoidata.toml [dev.node.*]
# Hash trigger: {{ include ".chezmoidata.toml" | sha256sum }}
# =============================================================================

set -euo pipefail

# Color codes
CYAN='\033[36m'
GREEN='\033[32m'
YELLOW='\033[33m'
GRAY='\033[90m'
RESET='\033[0m'

echo -e "${CYAN}=== Installing Node.js global packages ===${RESET}"

# Check if mise is installed
if ! command -v mise &>/dev/null; then
    echo -e "${YELLOW}WARNING: mise is not installed yet (skipping node package installation)${RESET}"
    exit 0
fi

# Check if node is available via mise
if ! mise exec -- node --version &>/dev/null; then
    echo -e "${YELLOW}WARNING: Node.js is not installed via mise yet (skipping)${RESET}"
    echo "Run 'mise install' to install Node.js first"
    exit 0
fi

node_version=$(mise exec -- node --version)
echo -e "${GRAY}Node.js version: $node_version${RESET}"

# Install pnpm global packages
{{- if .dev.node.pnpm }}
echo ""
echo -e "${YELLOW}Installing pnpm global packages...${RESET}"
{{- range .dev.node.pnpm }}
echo -e "${GREEN}Installing (pnpm): {{ . }}${RESET}"
mise exec -- pnpm add -g {{ . }} || echo -e "${YELLOW}Failed to install {{ . }}${RESET}"
{{- end }}
{{- end }}

# Install bun global packages
{{- if .dev.node.bun }}
echo ""
echo -e "${YELLOW}Installing bun global packages...${RESET}"
{{- range .dev.node.bun }}
echo -e "${GREEN}Installing (bun): {{ . }}${RESET}"
mise exec -- bun add -g {{ . }} || echo -e "${YELLOW}Failed to install {{ . }}${RESET}"
{{- end }}
{{- end }}

echo ""
echo -e "${GREEN}Node.js package installation complete!${RESET}"
{{- end }}

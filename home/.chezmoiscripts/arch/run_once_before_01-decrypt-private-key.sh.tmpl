#!/bin/bash
# vim: ft=bash

{{- if eq .chezmoi.os "linux" }}

set -euo pipefail

KEY_PATH="$HOME/.config/chezmoi/.chezmoi-crypto-key.txt"
SOURCE_FILE="{{ .chezmoi.sourceDir }}/chezmoi-crypto-key.txt.age"

if [ ! -f "$KEY_PATH" ]; then
  echo "Decrypting age private key..."

  mkdir -p "$(dirname "$KEY_PATH")"

  chezmoi age decrypt --output "$KEY_PATH" --passphrase "$SOURCE_FILE"

  chmod 600 "$KEY_PATH"

  echo "Age private key decrypted and permissions set to 600"
else
  echo "Age private key already exists (skipping)"
fi

{{- end }}

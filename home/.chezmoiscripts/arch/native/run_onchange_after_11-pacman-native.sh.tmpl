#!/bin/bash
# vim: ft=bash

{{- if eq .archEnv "native" }}

# =============================================================================
# Hash trigger: {{ include ".chezmoidata/pm/pacman.yml" | sha256sum }}
# =============================================================================

set -euo pipefail

{{ include ".chezmoitemplates/scripts/lib/bash/common.sh" }}
{{ include ".chezmoitemplates/scripts/error-policy.sh" }}
{{ include ".chezmoitemplates/scripts/lib/bash/pacman.sh" }}

print_header "Installing platform-specific packages (Arch Native - pacman)"

pacman_upgrade_once

# Install shared Arch packages
print_info ""
print_warn "Installing shared Arch packages..."
{{- range .pkgs.pacman.common }}
pacman_install_package "{{ . }}"
{{- end }}

# Install native-specific packages
{{- if .pkgs.pacman.native }}
print_info ""
print_warn "Installing native Arch-specific packages..."
{{- range .pkgs.pacman.native }}
pacman_install_package "{{ . }}"
{{- end }}
{{- end }}

print_info ""
print_info "Package installation complete!"
print_summary

{{- end }}

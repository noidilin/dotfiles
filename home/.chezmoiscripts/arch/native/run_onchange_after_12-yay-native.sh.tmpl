#!/bin/bash
# vim: ft=bash

{{- if eq .archEnv "native" }}

# =============================================================================
# Hash trigger: {{ include ".chezmoidata/pm/yay.yml" | sha256sum }}
# =============================================================================

set -euo pipefail

CYAN='\033[36m'
GREEN='\033[32m'
YELLOW='\033[33m'
RED='\033[31m'
GRAY='\033[90m'
WHITE='\033[97m'
RESET='\033[0m'

printf "${YELLOW}=== Installing platform-specific AUR packages (Arch Native - yay) ===${RESET}\n"

installed_count=0
skipped_count=0
failed_count=0
declare -a FAILED_ITEMS=()

record_installed() {
  ((installed_count+=1))
}

record_skipped() {
  ((skipped_count+=1))
}

record_failed() {
  local manager="$1"
  local package="$2"
  ((failed_count+=1))
  FAILED_ITEMS+=("${manager}:${package}")
}

print_summary() {
  printf "\n${WHITE}Summary: installed=%d skipped=%d failed=%d${RESET}\n" "$installed_count" "$skipped_count" "$failed_count"
  if [[ $failed_count -gt 0 ]]; then
    printf "${RED}Failed items:${RESET}\n"
    for item in "${FAILED_ITEMS[@]}"; do
      printf "${RED}- %s${RESET}\n" "$item"
    done
  fi
}

# Check if yay is installed
if ! command -v yay &>/dev/null; then
  printf "${RED}WARNING: yay is not installed (skipping AUR packages)${RESET}\n"
  printf "${GRAY}Install yay first, then run: chezmoi apply${RESET}\n"
  exit 0
fi

# Get yay version for logging
yay_version=$(yay --version 2>/dev/null | head -1 || echo "unknown")

declare -a YAY_INSTALLED=()
yay_cache_loaded=0

load_yay_packages() {
  if [[ $yay_cache_loaded -eq 1 ]]; then
    return
  fi

  yay_cache_loaded=1
  local output
  # Query foreign packages (AUR packages only)
  if ! output=$(yay -Qm 2>/dev/null); then
    YAY_INSTALLED=()
    return
  fi

  # Extract package names (first word of each line)
  while IFS= read -r line; do
    if [[ -n "$line" ]]; then
      pkg=$(echo "$line" | awk '{print $1}')
      if [[ -n "$pkg" ]]; then
        YAY_INSTALLED+=("$pkg")
      fi
    fi
  done <<<"$output"
}

yay_package_installed() {
  local package="$1"
  load_yay_packages

  for existing in "${YAY_INSTALLED[@]:-}"; do
    if [[ "$existing" == "$package" ]]; then
      return 0
    fi
  done

  return 1
}

install_yay_package() {
  local package="$1"

  if yay_package_installed "$package"; then
    printf "${GRAY}%s is already installed via yay (skipping)${RESET}\n" "$package"
    record_skipped
    return
  fi

  printf "${GREEN}Installing (yay): %s${RESET}\n" "$package"
  if ! yay -S --noconfirm "$package"; then
    printf "${RED}Failed to install %s (yay)${RESET}\n" "$package"
    record_failed "yay" "$package"
  else
    record_installed
  fi
}

printf "${GRAY}\nyay version: %s${RESET}\n" "$yay_version"

# Install shared AUR packages
{{- if .pkgs.yay.common }}
printf "${YELLOW}Installing shared AUR packages...${RESET}\n"
{{- range .pkgs.yay.common }}
install_yay_package "{{ . }}"
{{- end }}
{{- end }}

# Install native-specific AUR packages
{{- if .pkgs.yay.native }}
printf "${YELLOW}Installing native Arch-specific AUR packages...${RESET}\n"
{{- range .pkgs.yay.native }}
install_yay_package "{{ . }}"
{{- end }}
{{- end }}

printf "${WHITE}\nAUR package installation complete!${RESET}\n"
print_summary

{{- end }}

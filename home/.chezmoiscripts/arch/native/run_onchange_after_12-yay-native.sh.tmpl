#!/bin/bash
# vim: ft=bash

{{- if eq .archEnv "native" }}

# =============================================================================
# Hash trigger: {{ include ".chezmoidata/pm/yay.yml" | sha256sum }}
# =============================================================================

set -euo pipefail

{{ include ".chezmoitemplates/scripts/lib/bash/common.sh" }}
{{ include ".chezmoitemplates/scripts/error-policy.sh" }}
{{ include ".chezmoitemplates/scripts/lib/bash/yay.sh" }}

print_header "Installing platform-specific AUR packages (Arch Native - yay)"

if ! command -v yay &>/dev/null; then
  print_error "WARNING: yay is not installed (skipping AUR packages)"
  print_skip "Install yay first, then run: chezmoi apply"
  exit 0
fi

yay_version=$(yay_version_line)

print_skip ""
print_skip "yay version: $yay_version"

# Install shared AUR packages
{{- if .pkgs.yay.common }}
print_warn "Installing shared AUR packages..."
{{- range .pkgs.yay.common }}
yay_install_package "{{ . }}"
{{- end }}
{{- end }}

# Install native-specific AUR packages
{{- if .pkgs.yay.native }}
print_warn "Installing native Arch-specific AUR packages..."
{{- range .pkgs.yay.native }}
yay_install_package "{{ . }}"
{{- end }}
{{- end }}

print_info ""
print_info "AUR package installation complete!"
print_summary

{{- end }}

#!/bin/bash
# vim: ft=bash

{{- if eq .archEnv "native" }}

# =============================================================================
# Hash trigger: {{ include ".chezmoidata/pm/common.yml" | sha256sum }}
# =============================================================================

set -euo pipefail

{{ include ".chezmoitemplates/scripts/lib/bash/common.sh" }}
{{ include ".chezmoitemplates/scripts/error-policy.sh" }}
{{ include ".chezmoitemplates/scripts/lib/bash/pacman.sh" }}
{{ include ".chezmoitemplates/scripts/lib/bash/yay.sh" }}

print_header "Installing common packages (Arch Native)"

pacman_upgrade_once

# Install common packages via pacman (includes GUI apps)
print_info ""
print_warn "Installing common packages via pacman..."
{{- range $name, $pkg := .pkgs.common }}
{{- if hasKey $pkg "pacman" }}
pacman_install_package "{{ $pkg.pacman }}"
{{- end }}
{{- end }}

# Install common packages via yay/AUR (includes GUI apps)
if command -v yay &>/dev/null; then
  print_info ""
  print_warn "Installing common packages via yay..."
  {{- range $name, $pkg := .pkgs.common }}
  {{- if hasKey $pkg "aur" }}
  yay_install_package "{{ $pkg.aur }}"
  {{- end }}
  {{- end }}
else
  print_warn "yay not installed, skipping AUR packages"
fi

print_info ""
print_info "Common package installation complete!"
print_summary

{{- end }}

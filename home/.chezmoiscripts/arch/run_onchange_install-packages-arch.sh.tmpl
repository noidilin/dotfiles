#!/bin/bash
# vim: ft=bash

{{- if eq .chezmoi.os "linux" }}
{{- if eq .chezmoi.osRelease.id "arch" }}

# =============================================================================
# Install Essential Packages for Arch Linux
# =============================================================================
# Execution Order: No number (run_onchange_*)
# - Runs on every `chezmoi apply` when chezmoidata files change
# - Installs system packages via pacman
# - Should run before Node.js package script (12)
# Source: .chezmoidata/pkg-manager/{common,pacman}.yml
# Hash trigger: {{ include ".chezmoidata/pkg-manager/common.yml" | sha256sum }}{{ include ".chezmoidata/pkg-manager/pacman.yml" | sha256sum }}
# =============================================================================

set -euo pipefail

# Color codes
CYAN='\033[36m'
GREEN='\033[32m'
YELLOW='\033[33m'
GRAY='\033[90m'
RESET='\033[0m'

echo -e "${CYAN}=== Installing essential packages for Arch Linux ===${RESET}"

# Update package database
sudo pacman -Syu --noconfirm

# Build package list from .chezmoidata/
packages=(
    # Core shell (always needed)
    nushell
    
    # CLI tools (common across platforms, with name mapping)
{{- range .pkgs.common }}
    {{- $pkg := . }}
    {{- if eq $pkg "delta" -}}
    git-delta
    {{- else if eq $pkg "gpg" -}}
    gnupg
    {{- else if eq $pkg "openssh" -}}
    openssh  # Usually pre-installed
    {{- else if eq $pkg "7zip" -}}
    p7zip
    {{- else -}}
    {{ $pkg }}
    {{- end }}
{{- end }}
    
    # Linux-specific packages (pacman)
{{- range .pkgs.pacman }}
    {{ . }}
{{- end }}
)

# Install packages
for package in "${packages[@]}"; do
    if ! pacman -Q "$package" &>/dev/null; then
        echo -e "${GREEN}Installing: $package${RESET}"
        sudo pacman -S --noconfirm "$package" || echo -e "${YELLOW}Failed to install $package${RESET}"
    else
        echo -e "${GRAY}$package is already installed (skipping)${RESET}"
    fi
done

# Set nushell as default shell if not already set
if [[ "$SHELL" != *"nu"* ]]; then
    echo ""
    echo -e "${YELLOW}Nushell is installed but not set as your default shell.${RESET}"
    echo "To change your default shell, run:"
    echo -e "  ${GREEN}chsh -s \$(which nu)${RESET}"
    echo ""
    echo "Then log out and log back in for changes to take effect."
    echo "After logging back in, re-run 'chezmoi apply' to continue setup."
fi

echo -e "${GREEN}Package installation complete!${RESET}"

{{- end }}
{{- end }}

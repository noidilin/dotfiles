#!/bin/bash
# vim: ft=bash

{{- if eq .chezmoi.os "linux" }}

# =============================================================================
# Hash trigger: {{ include ".chezmoidata/pm/cargo.yml" | sha256sum }}
# =============================================================================

set -euo pipefail

{{ include ".chezmoitemplates/scripts/lib/bash/common.sh" }}
{{ include ".chezmoitemplates/scripts/error-policy.sh" }}
{{ include ".chezmoitemplates/scripts/lib/bash/cargo.sh" }}

print_header "Installing cargo packages"

require_command_or_skip "mise" "WARNING: mise is not installed (skipping cargo packages)"

if ! cargo_version=$(mise exec -- cargo --version 2>/dev/null); then
  print_error "WARNING: cargo is not available via mise (skipping cargo packages)"
  exit 0
fi

{{- if .pkgs.cargo }}
print_skip ""
print_skip "cargo version: $cargo_version"
print_info "Installing cargo packages..."
{{- range .pkgs.cargo }}
cargo_install_package "{{ . }}"
{{- end }}
{{- else }}
print_skip "No cargo packages declared (skipping)"
{{- end }}

print_info ""
print_info "cargo package installation complete!"
print_summary
{{- end }}

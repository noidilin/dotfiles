#!/bin/bash
# vim: ft=bash

{{- if eq .chezmoi.os "linux" }}
# =============================================================================
# Install Language Package Managers (Linux)
# =============================================================================
# Execution Order: 13 (run_onchange_after_13-*)
# - Runs on every `chezmoi apply` when package manager files change
# - Installs global packages via pnpm, uv, cargo
# - Requires mise and runtimes to be installed (from script 12)
# Source: .chezmoidata/pkg-manager/node.yml
# Hash trigger: {{ include ".chezmoidata/pkg-manager/node.yml" | sha256sum }}
# =============================================================================

set -euo pipefail

# Color codes
CYAN='\033[36m'
GREEN='\033[32m'
YELLOW='\033[33m'
RED='\033[31m'
GRAY='\033[90m'
RESET='\033[0m'

echo -e "${CYAN}=== Installing language packages ===${RESET}"

# Check if mise is installed
if ! command -v mise &>/dev/null; then
    echo -e "${YELLOW}WARNING: mise is not installed yet (skipping language package installation)${RESET}"
    exit 0
fi

# Function to install pnpm package
function install_pnpm_package() {
    local package="$1"
    
    echo -e "${GREEN}Installing (pnpm): $package${RESET}"
    mise exec -- pnpm add -g "$package" || \
        echo -e "${RED}Failed to install $package${RESET}"
}

# Install pnpm global packages (Node.js)
{{- if .pkgs.node }}
if mise exec -- node --version &>/dev/null; then
    node_version=$(mise exec -- node --version)
    echo -e "\n${GRAY}Node.js version: $node_version${RESET}"
    echo -e "${YELLOW}Installing pnpm global packages...${RESET}"
    {{- range .pkgs.node }}
    install_pnpm_package "{{ . }}"
    {{- end }}
else
    echo -e "\n${YELLOW}WARNING: Node.js is not installed via mise yet (skipping Node packages)${RESET}"
fi
{{- end }}

echo -e "\n${GREEN}Language package installation complete!${RESET}"
{{- end }}

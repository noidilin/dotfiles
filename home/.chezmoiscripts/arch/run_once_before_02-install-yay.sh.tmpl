#!/bin/bash
# vim: ft=bash

{{- if eq .osId "linux-arch" }}

# =============================================================================
# Install yay AUR Helper (Arch Linux - Both WSL2 and Native)
# =============================================================================
# Execution Order: 02 (run_once_before_02-*)
# - Runs once during initial setup or after manual deletion
# - Installs yay from AUR if not already installed
# - Required for installing AUR packages from yay.yml
# - Requires base-devel and git to be installed
#
# Reinstall: rm -rf ~/.cache/yay-build && yay -Rns yay && chezmoi apply
# =============================================================================

set -euo pipefail

# Color codes
CYAN='\033[36m'
GREEN='\033[32m'
YELLOW='\033[33m'
RED='\033[31m'
GRAY='\033[90m'
BRIGHT_WHITE='\033[97m'
RESET='\033[0m'

BUILD_DIR="$HOME/.cache/yay-build"

echo -e "${YELLOW}=== Installing yay AUR Helper ===${RESET}"

# Check if yay is already installed
if command -v yay &>/dev/null; then
  CURRENT_VERSION=$(yay --version 2>/dev/null | head -1 || echo "unknown")
  echo -e "${GRAY}yay is already installed${RESET}"
  echo -e "${GRAY}Current version: $CURRENT_VERSION${RESET}"
  echo -e "${BRIGHT_WHITE}To reinstall: rm -rf ~/.cache/yay-build && yay -Rns yay && chezmoi apply${RESET}"
  exit 0
fi

# Check dependencies
echo -e "${BRIGHT_WHITE}Checking dependencies...${RESET}"
MISSING_DEPS=()

if ! pacman -Q base-devel &>/dev/null; then
  MISSING_DEPS+=("base-devel")
fi

if ! pacman -Q git &>/dev/null; then
  MISSING_DEPS+=("git")
fi

if [ ${#MISSING_DEPS[@]} -gt 0 ]; then
  echo -e "${RED}✗ Missing required dependencies: ${MISSING_DEPS[*]}${RESET}"
  echo -e "${BRIGHT_WHITE}Installing dependencies...${RESET}"
  sudo pacman -S --noconfirm "${MISSING_DEPS[@]}" || {
    echo -e "${RED}Failed to install dependencies${RESET}"
    exit 1
  }
  echo -e "${BRIGHT_WHITE}✓ Dependencies installed${RESET}"
fi

# Create build directory
echo -e "${BRIGHT_WHITE}Creating build directory...${RESET}"
mkdir -p "$BUILD_DIR"

# Clone yay repository
echo -e "${BRIGHT_WHITE}Cloning yay repository...${RESET}"
if [ -d "$BUILD_DIR/yay" ]; then
  echo -e "${GRAY}Build directory exists, cleaning...${RESET}"
  rm -rf "$BUILD_DIR/yay"
fi

if ! git clone https://aur.archlinux.org/yay.git "$BUILD_DIR/yay"; then
  echo -e "${RED}✗ Failed to clone yay repository${RESET}"
  echo -e "${BRIGHT_WHITE}Troubleshooting:${RESET}"
  echo -e "  1. Check internet connection"
  echo -e "  2. Verify git is installed: pacman -Q git"
  echo -e "  3. Try manual clone: git clone https://aur.archlinux.org/yay.git"
  exit 1
fi

# Build and install yay
echo -e "${BRIGHT_WHITE}Building and installing yay...${RESET}"
cd "$BUILD_DIR/yay"

if ! makepkg -si --noconfirm; then
  echo -e "${RED}✗ Failed to build/install yay${RESET}"
  echo -e "${BRIGHT_WHITE}Troubleshooting:${RESET}"
  echo -e "  1. Check if base-devel is installed: pacman -Q base-devel"
  echo -e "  2. Try manual build: cd ~/.cache/yay-build/yay && makepkg -si"
  echo -e "  3. Check build logs for specific errors"
  exit 1
fi

# Verify installation
if command -v yay &>/dev/null; then
  VERSION=$(yay --version 2>/dev/null | head -1 || echo "unknown")
  echo -e "${BRIGHT_WHITE}✓ yay installed successfully${RESET}"
  echo -e "${BRIGHT_WHITE}✓ Verified: $VERSION${RESET}"
  echo -e "${GRAY}Location: $(which yay)${RESET}"
else
  echo -e "${RED}✗ Verification failed: yay command not found${RESET}"
  exit 1
fi

# Clean up build directory (optional)
echo -e "${BRIGHT_WHITE}Cleaning up build directory...${RESET}"
rm -rf "$BUILD_DIR/yay"
echo -e "${BRIGHT_WHITE}✓ Build directory cleaned${RESET}"

echo -e "\n${BRIGHT_WHITE}=== yay installation complete! ===${RESET}"
echo -e "${BRIGHT_WHITE}Next steps:${RESET}"
echo -e "  1. ${BRIGHT_WHITE}Install AUR packages${RESET}: ${GRAY}yay -S <package>${RESET}"
echo -e "  2. ${BRIGHT_WHITE}Search AUR${RESET}: ${GRAY}yay -Ss <search-term>${RESET}"
echo -e "  3. ${BRIGHT_WHITE}Update AUR packages${RESET}: ${GRAY}yay -Syu${RESET}"
echo -e "  4. ${BRIGHT_WHITE}AUR packages from yay.yml will be installed automatically${RESET}"

{{- end }}

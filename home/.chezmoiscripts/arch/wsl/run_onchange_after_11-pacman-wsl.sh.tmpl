#!/bin/bash
# vim: ft=bash

{{- if eq .archEnv "wsl" }}

# =============================================================================
# Hash trigger: {{ include ".chezmoidata/pm/pacman.yml" | sha256sum }}
# =============================================================================

set -euo pipefail

# Color codes
CYAN='\033[36m'
GREEN='\033[32m'
YELLOW='\033[33m'
RED='\033[31m'
GRAY='\033[90m'
WHITE='\033[97m'
RESET='\033[0m'

echo -e "${YELLOW}=== Installing platform-specific packages (Arch WSL - pacman) ===${RESET}"

installed_count=0
skipped_count=0
failed_count=0
declare -a FAILED_ITEMS=()

record_installed() {
  ((installed_count+=1))
}

record_skipped() {
  ((skipped_count+=1))
}

record_failed() {
  local manager="$1"
  local package="$2"
  ((failed_count+=1))
  FAILED_ITEMS+=("${manager}:${package}")
}

print_summary() {
  printf "\n${WHITE}Summary: installed=%d skipped=%d failed=%d${RESET}\n" "$installed_count" "$skipped_count" "$failed_count"
  if [[ $failed_count -gt 0 ]]; then
    printf "${RED}Failed items:${RESET}\n"
    for item in "${FAILED_ITEMS[@]}"; do
      printf "${RED}- %s${RESET}\n" "$item"
    done
  fi
}

# Cache for installed packages (loaded once)
declare -a PACMAN_INSTALLED=()
pacman_cache_loaded=0

load_pacman_packages() {
  if [[ $pacman_cache_loaded -eq 1 ]]; then
    return
  fi

  pacman_cache_loaded=1
  local output
  # -Qq: query, quiet (package names only)
  if ! output=$(pacman -Qq 2>/dev/null); then
    echo -e "${RED}WARNING: Failed to query installed packages (skipping all)${RESET}"
    PACMAN_INSTALLED=()
    return
  fi

  while IFS= read -r pkg; do
    if [[ -n "$pkg" ]]; then
      PACMAN_INSTALLED+=("$pkg")
    fi
  done <<<"$output"
}

pacman_package_installed() {
  local package="$1"
  load_pacman_packages

  for existing in "${PACMAN_INSTALLED[@]:-}"; do
    if [[ "$existing" == "$package" ]]; then
      return 0
    fi
  done

  return 1
}

# Function to install package if not already installed
function install_pacman_package() {
  local package="$1"

  if pacman_package_installed "$package"; then
    echo -e "${GRAY}$package is already installed (skipping)${RESET}"
    record_skipped
    return
  fi

  echo -e "${GREEN}Installing: $package${RESET}"
  if sudo pacman -S --noconfirm "$package"; then
    record_installed
  else
    echo -e "${RED}Failed to install $package${RESET}"
    record_failed "pacman" "$package"
  fi
}

# Update package database
sudo pacman -Syu --noconfirm

# Install shared Arch packages
echo -e "\n${YELLOW}Installing shared Arch packages...${RESET}"
{{- range .pkgs.pacman.common }}
install_pacman_package "{{ . }}"
{{- end }}

# Install WSL2-specific packages
{{- if .pkgs.pacman.wsl }}
echo -e "\n${YELLOW}Installing WSL2-specific packages...${RESET}"
{{- range .pkgs.pacman.wsl }}
install_pacman_package "{{ . }}"
{{- end }}
{{- end }}

echo -e "\n${WHITE}Package installation complete!${RESET}"
print_summary

{{- end }}

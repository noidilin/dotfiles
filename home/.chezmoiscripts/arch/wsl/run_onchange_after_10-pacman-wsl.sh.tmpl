#!/bin/bash
# vim: ft=bash

{{- if eq .archEnv "wsl" }}

# =============================================================================
# Install System Packages for WSL2 Arch Linux
# =============================================================================
# Execution Order: 10 (run_onchange_after_10-*)
# - Runs on every `chezmoi apply` when chezmoidata files change
# - Installs system packages via pacman for WSL2 environment
# - Should run before mise tools (30) and language packages (40)
# Source: .chezmoidata/pkg-manager/{common,pacman,pacman-wsl}.yml
# Hash trigger: {{ include ".chezmoidata/pkg-manager/common.yml" | sha256sum }}{{ include ".chezmoidata/pkg-manager/pacman.yml" | sha256sum }}{{ include ".chezmoidata/pkg-manager/pacman-wsl.yml" | sha256sum }}
# =============================================================================

set -euo pipefail

# Color codes
CYAN='\033[36m'
GREEN='\033[32m'
YELLOW='\033[33m'
RED='\033[31m'
GRAY='\033[90m'
RESET='\033[0m'

echo -e "${CYAN}=== Installing system packages for WSL2 Arch Linux ===${RESET}"

# Cache for installed packages (loaded once)
declare -a PACMAN_INSTALLED=()
pacman_cache_loaded=0

load_pacman_packages() {
    if [[ $pacman_cache_loaded -eq 1 ]]; then
        return
    fi
    
    pacman_cache_loaded=1
    local output
    # -Qq: query, quiet (package names only)
    if ! output=$(pacman -Qq 2>/dev/null); then
        echo -e "${YELLOW}WARNING: Failed to query installed packages (skipping all)${RESET}"
        PACMAN_INSTALLED=()
        return
    fi
    
    while IFS= read -r pkg; do
        if [[ -n "$pkg" ]]; then
            PACMAN_INSTALLED+=("$pkg")
        fi
    done <<< "$output"
}

pacman_package_installed() {
    local package="$1"
    load_pacman_packages
    
    for existing in "${PACMAN_INSTALLED[@]:-}"; do
        if [[ "$existing" == "$package" ]]; then
            return 0
        fi
    done
    
    return 1
}

# Function to install package if not already installed
function install_pacman_package() {
    local package="$1"
    
    if pacman_package_installed "$package"; then
        echo -e "${GRAY}$package is already installed (skipping)${RESET}"
        return
    fi
    
    echo -e "${GREEN}Installing: $package${RESET}"
    sudo pacman -S --noconfirm "$package" || \
        echo -e "${RED}Failed to install $package${RESET}"
}

# Update package database
sudo pacman -Syu --noconfirm

# Install common packages (cross-platform)
echo -e "\n${YELLOW}Installing common packages (cross-platform)...${RESET}"
{{- range .pkgs.common }}
install_pacman_package "{{ . }}"
{{- end }}

# Install shared Arch packages
echo -e "\n${YELLOW}Installing shared Arch packages...${RESET}"
{{- range .pkgs.pacman }}
install_pacman_package "{{ . }}"
{{- end }}

# Install WSL2-specific packages
{{- if .pkgs.pacmanWsl }}
echo -e "\n${YELLOW}Installing WSL2-specific packages...${RESET}"
{{- range .pkgs.pacmanWsl }}
install_pacman_package "{{ . }}"
{{- end }}
{{- end }}

echo -e "\n${GREEN}Package installation complete!${RESET}"

{{- end }}

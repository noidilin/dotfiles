# Download Rime Wanxiang language model (one-time)
# Hash: {{ stat (joinPath .chezmoi.homeDir ".config" "rime" "wanxiang-lts-zh-hans.gram") }}

$ErrorActionPreference = "Stop"

$RIME_DIR = Join-Path $env:USERPROFILE ".config\rime"
$GRAM_FILE = Join-Path $RIME_DIR "wanxiang-lts-zh-hans.gram"
$GRAM_URL = "https://github.com/amzxyz/RIME-LMDG/releases/download/LTS/wanxiang-lts-zh-hans.gram"

# Create directory if it doesn't exist
if (-not (Test-Path $RIME_DIR)) {
    New-Item -ItemType Directory -Path $RIME_DIR -Force | Out-Null
}

if (-not (Test-Path $GRAM_FILE)) {
    Write-Host "Downloading Rime language model (197MB)..."
    try {
        Invoke-WebRequest -Uri $GRAM_URL -OutFile $GRAM_FILE -UseBasicParsing
        Write-Host "✓ Language model downloaded successfully" -ForegroundColor Green
    } catch {
        Write-Error "Failed to download language model: $_"
        exit 1
    }
} else {
    Write-Host "✓ Language model already exists" -ForegroundColor Green
}

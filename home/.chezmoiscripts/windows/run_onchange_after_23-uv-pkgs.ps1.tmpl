# vim: ft=powershell

{{- if eq .chezmoi.os "windows" }}

# =============================================================================
# Hash trigger: {{ include ".chezmoidata/pm/uv.yml" | sha256sum }}
# =============================================================================

Write-Host "=== Installing uv tool packages ===" -ForegroundColor Yellow

{{ include ".chezmoitemplates/scripts/error-policy.ps1" }}
{{ include ".chezmoitemplates/scripts/lib/powershell/common.ps1" }}
{{ include ".chezmoitemplates/scripts/lib/powershell/uv.ps1" }}

if (!(Assert-MiseToolOrSkip -Tool "uv" -MissingMiseMessage "WARNING: mise is not installed (skipping uv packages)" -MissingToolMessage "WARNING: uv is not available via mise (skipping uv packages)")) {
    exit 0
}

$uvVersion = $script:MiseToolVersion

{{- if .pkgs.uv }}
Write-Host "`nuv version: $uvVersion" -ForegroundColor DarkGray
Write-Host "Installing uv tools..." -ForegroundColor White
{{-   range .pkgs.uv }}
Install-UvTool "{{ . }}"
{{-   end }}
{{- else }}
Write-Host "No uv tools declared (skipping)" -ForegroundColor DarkGray
{{- end }}

Write-Host "`nuv tool installation complete!" -ForegroundColor White
Write-InstallSummary
{{- end }}

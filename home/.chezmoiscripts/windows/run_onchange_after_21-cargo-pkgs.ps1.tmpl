# vim: ft=powershell

{{- if eq .chezmoi.os "windows" }}

# =============================================================================
# Hash trigger: {{ include ".chezmoidata/pm/cargo.yml" | sha256sum }}
# =============================================================================

Write-Host "=== Installing cargo packages ===" -ForegroundColor Yellow

{{ include ".chezmoitemplates/scripts/error-policy.ps1" }}
{{ include ".chezmoitemplates/scripts/lib/powershell/common.ps1" }}
{{ include ".chezmoitemplates/scripts/lib/powershell/cargo.ps1" }}

if (!(Assert-MiseToolOrSkip -Tool "cargo" -MissingMiseMessage "WARNING: mise is not installed (skipping cargo packages)" -MissingToolMessage "WARNING: cargo is not available via mise (skipping cargo packages)")) {
    exit 0
}

$cargoVersion = $script:MiseToolVersion

{{- if .pkgs.cargo }}
Write-Host "`ncargo version: $cargoVersion" -ForegroundColor DarkGray
Write-Host "Installing cargo packages..." -ForegroundColor White
{{-   range .pkgs.cargo }}
Install-CargoPackage "{{ . }}"
{{-   end }}
{{- else }}
Write-Host "No cargo packages declared (skipping)" -ForegroundColor DarkGray
{{- end }}

Write-Host "`ncargo package installation complete!" -ForegroundColor White
Write-InstallSummary
{{- end }}

# vim: ft=powershell

{{- if eq .chezmoi.os "windows" }}

# =============================================================================
# Hash trigger: {{ include ".chezmoidata/env/windows.yml" | sha256sum }}
# =============================================================================

Write-Host "=== Setting up symbolic links (Windows) ===" -ForegroundColor Yellow

{{- if not .symlinks.windows }}
Write-Host "No Windows symlink definitions found .symlinks.windows). Skipping." -ForegroundColor White
return
{{- else }}
$symlinkItems = @(
{{-   range .symlinks.windows }}
    @{
        Target = "{{ .target }}"
        Source = "{{ .source }}"
    }
{{-   end }}
)
{{- end }}

if ($symlinkItems.Count -eq 0) {
    Write-Host "No Windows symlink entries were provided. Skipping." -ForegroundColor White
    return
}

function Ensure-ParentDirectory {
    param(
        [Parameter(Mandatory = $true)]
        [string]$TargetPath
    )

    $parent = Split-Path -Path $TargetPath -Parent
    if ([string]::IsNullOrWhiteSpace($parent)) {
        return
    }

    if (-not (Test-Path -LiteralPath $parent)) {
        Write-Host "Creating directory: $parent" -ForegroundColor White
        New-Item -ItemType Directory -Path $parent -Force | Out-Null
    }
}

function New-SymbolicLinkSafe {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Target,
        [Parameter(Mandatory = $true)]
        [string]$Source
    )

    if ([string]::IsNullOrWhiteSpace($Source) -or [string]::IsNullOrWhiteSpace($Target)) {
        Write-Host "Invalid source/target encountered; skipping." -ForegroundColor Red
        return $false
    }

    if (-not (Test-Path -LiteralPath $Source)) {
        Write-Host "Source missing for target $Target - skipping. ($Source)" -ForegroundColor White
        return $false
    }

    Ensure-ParentDirectory -TargetPath $Target

    if (Test-Path -LiteralPath $Target) {
        $existingItem = Get-Item -LiteralPath $Target -Force
        $isLink = $existingItem.Attributes.HasFlag([IO.FileAttributes]::ReparsePoint)

        if ($isLink) {
            $currentTarget = ($existingItem.Target -join '')
            if ($currentTarget -eq $Source) {
                Write-Host "Already linked: $Target" -ForegroundColor DarkGray
                return $false
            }
        }

        Write-Host "Removing existing target: $Target" -ForegroundColor White
        Remove-Item -LiteralPath $Target -Force -Recurse
    }

    try {
        New-Item -ItemType SymbolicLink -Path $Target -Target $Source -Force | Out-Null
        Write-Host "Linked: $Target -> $Source" -ForegroundColor White
        return $true
    } catch {
        Write-Host "Failed to create link for $Target : $_" -ForegroundColor Red
        return $false
    }
}

$updatedCount = 0

foreach ($item in $symlinkItems) {
    $targetPath = $item.Target
    $sourcePath = $item.Source

    if (New-SymbolicLinkSafe -Target $targetPath -Source $sourcePath) {
        $updatedCount++
    }
}

Write-Host "`nSymlink setup complete. Updated $updatedCount item(s)." -ForegroundColor White
{{- end }}

# vim: ft=powershell

{{- if eq .chezmoi.os "windows" }}

# =============================================================================
# Hash trigger: {{ include ".chezmoidata/env.yml" | sha256sum }}
# =============================================================================

$DevDirectories = @(
{{- range .env.runtimeDirs }}
    "$HOME\{{ join `\` . }}"
{{- end }}
)

foreach ($Directory in $DevDirectories) {
    if (-Not (Test-Path -LiteralPath $Directory -PathType Container)) {
        New-Item -ItemType Directory -Path $Directory -Force | Out-Null
    }
}
{{- end }}

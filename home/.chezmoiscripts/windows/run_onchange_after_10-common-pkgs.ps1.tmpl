# vim: ft=powershell

{{- if eq .chezmoi.os "windows" }}

# =============================================================================
# Hash trigger: {{ include ".chezmoidata/pm/common.yml" | sha256sum }}
# =============================================================================

Write-Host "=== Installing common packages (Windows) ===" -ForegroundColor Yellow

# Check if scoop is installed
if (!(Get-Command scoop -ErrorAction SilentlyContinue)) {
    Write-Host "ERROR: Scoop is not installed!" -ForegroundColor Red
    Write-Host "Please install Scoop first: https://scoop.sh" -ForegroundColor White
    exit 1
}

# Check if winget is installed
if (!(Get-Command winget -ErrorAction SilentlyContinue)) {
    Write-Host "ERROR: WinGet is not installed!" -ForegroundColor Red
    Write-Host "WinGet comes with Windows 11 or can be installed via Microsoft Store (App Installer)" -ForegroundColor White
    exit 1
}

# ============================================================================
# Scoop Package Installation Functions
# ============================================================================

# Cache for installed packages (loaded once)
$script:ScoopPackages = $null

function Get-ScoopInstalledPackages {
    if ($null -ne $script:ScoopPackages) {
        return $script:ScoopPackages
    }
    
    $script:ScoopPackages = @()
    
    try {
        # scoop list returns PowerShell objects with .Name property
        # Extract package names directly from the objects
        $installed = scoop list 2>$null
        if ($LASTEXITCODE -ne 0 -or -not $installed) {
            Write-Host "WARNING: Failed to query installed packages (skipping all)" -ForegroundColor Red
            return $script:ScoopPackages
        }
        
        # Extract the Name property from each package object
        $script:ScoopPackages = @($installed.Name)
    } catch {
        Write-Host "WARNING: Failed to query installed packages: $_" -ForegroundColor Red
    }
    
    return $script:ScoopPackages
}

function Test-ScoopPackageInstalled {
    param([string]$Package)
    
    $installed = Get-ScoopInstalledPackages
    return $installed -contains $Package
}

# Function to install package if not already installed
function Install-ScoopPackage {
    param([string]$Package)
    
    # Check if already installed
    if (Test-ScoopPackageInstalled -Package $Package) {
        Write-Host "$Package is already installed (skipping)" -ForegroundColor DarkGray
        return
    }
    
    Write-Host "Installing: $Package" -ForegroundColor White
    try {
        scoop install $Package
    } catch {
        Write-Host "Failed to install $Package : $_" -ForegroundColor Red
    }
}

# ============================================================================
# WinGet Package Installation Functions
# ============================================================================

# Cache for installed packages (loaded once)
$script:WingetPackages = $null

function Get-WingetInstalledPackages {
    if ($null -ne $script:WingetPackages) {
        return $script:WingetPackages
    }
    
    $script:WingetPackages = @()
    
    # Create temp file for JSON export
    $tempFile = [System.IO.Path]::GetTempFileName()
    try {
        # Export installed packages to JSON
        winget export -o $tempFile --accept-source-agreements 2>$null | Out-Null
        if ($LASTEXITCODE -ne 0 -or !(Test-Path $tempFile)) {
            Write-Host "WARNING: Failed to query installed packages (skipping all)" -ForegroundColor Red
            return $script:WingetPackages
        }
        
        # Parse JSON to extract package IDs
        $jsonContent = Get-Content $tempFile -Raw | ConvertFrom-Json
        if ($jsonContent.Sources) {
            foreach ($source in $jsonContent.Sources) {
                if ($source.Packages) {
                    foreach ($pkg in $source.Packages) {
                        if ($pkg.PackageIdentifier) {
                            $script:WingetPackages += $pkg.PackageIdentifier
                        }
                    }
                }
            }
        }
    } catch {
        Write-Host "WARNING: Failed to parse installed packages: $_" -ForegroundColor Red
    } finally {
        if (Test-Path $tempFile) {
            Remove-Item $tempFile -Force
        }
    }
    
    return $script:WingetPackages
}

function Test-WinGetPackage {
    param([string]$PackageId)
    
    $installed = Get-WingetInstalledPackages
    return $installed -contains $PackageId
}

# Function to install package if not already installed
function Install-WinGetPackage {
    param([string]$PackageId)
    
    if (Test-WinGetPackage $PackageId) {
        Write-Host "$PackageId is already installed (skipping)" -ForegroundColor DarkGray
        return
    }
    
    Write-Host "Installing: $PackageId" -ForegroundColor White
    try {
        winget install --id $PackageId --silent --accept-source-agreements --accept-package-agreements
        if ($LASTEXITCODE -ne 0) {
            Write-Host "Failed to install $PackageId (exit code: $LASTEXITCODE)" -ForegroundColor Red
        }
    } catch {
        Write-Host "Failed to install $PackageId : $_" -ForegroundColor Red
    }
}

# ============================================================================
# Install Common Packages
# ============================================================================

# Install common packages via Scoop
Write-Host "`nInstalling common packages via Scoop..." -ForegroundColor White
{{- range $name, $pkg := .pkgs.common }}
  {{- if hasKey $pkg "scoop" }}
Install-ScoopPackage "{{ $pkg.scoop }}"
  {{- end }}
{{- end }}

# Install common packages via WinGet
Write-Host "`nInstalling common packages via WinGet..." -ForegroundColor White
{{- range $name, $pkg := .pkgs.common }}
  {{- if hasKey $pkg "winget" }}
Install-WinGetPackage "{{ $pkg.winget }}"
  {{- end }}
{{- end }}

Write-Host "`nCommon package installation complete!" -ForegroundColor White
{{- end }}

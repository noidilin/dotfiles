# vim: ft=powershell

{{- if eq .chezmoi.os "windows" }}

# =============================================================================
# Hash trigger: {{ include ".chezmoidata/pm/pnpm.yml" | sha256sum }}
# =============================================================================

Write-Host "=== Installing pnpm global packages ===" -ForegroundColor Yellow

if (!(Get-Command mise -ErrorAction SilentlyContinue)) {
    Write-Host "WARNING: mise is not installed (skipping pnpm packages)" -ForegroundColor Red
    exit 0
}

$nodeVersion = mise exec -- node --version 2>$null
if ($LASTEXITCODE -ne 0) {
    Write-Host "WARNING: Node.js is not available via mise (skipping pnpm packages)" -ForegroundColor Red
    exit 0
}

$pnpmVersion = mise exec -- pnpm --version 2>$null
if ($LASTEXITCODE -ne 0) {
    Write-Host "WARNING: pnpm is not available via mise (skipping pnpm packages)" -ForegroundColor Red
    exit 0
}

$script:PnpmPackages = $null
function Get-PnpmInstalledPackages {
    if ($null -ne $script:PnpmPackages) {
        return $script:PnpmPackages
    }

    $script:PnpmPackages = @()
    $rawOutput = mise exec -- pnpm ls -g --depth=0 2>$null
    if ($LASTEXITCODE -ne 0 -or -not $rawOutput) {
        return $script:PnpmPackages
    }

    # Use ripgrep to extract package names: filter lines starting with @ or lowercase, exclude "dependencies:"
    $packages = $rawOutput | rg -N '^[@a-z]' | rg -o '^\S+' | rg -v '^dependencies:$'
    foreach ($pkg in $packages) {
        if ($pkg) {
            $script:PnpmPackages += $pkg
        }
    }

    return $script:PnpmPackages
}

function Test-PnpmPackageInstalled {
    param([string]$Package)
    $installed = Get-PnpmInstalledPackages
    return $installed -contains $Package
}

function Install-PnpmPackage {
    param([string]$Package)

    if (Test-PnpmPackageInstalled -Package $Package) {
        Write-Host "$Package is already installed via pnpm (skipping)" -ForegroundColor DarkGray
        return
    }

    Write-Host "Installing (pnpm): $Package" -ForegroundColor White
    try {
        mise exec -- pnpm add -g $Package
    } catch {
        Write-Host "Failed to install $Package (pnpm): $_" -ForegroundColor Red
    }
}

{{- if .pkgs.pnpm }}
Write-Host "`nNode.js version: $nodeVersion" -ForegroundColor DarkGray
Write-Host "Installing pnpm packages..." -ForegroundColor White
{{-   range .pkgs.pnpm }}
Install-PnpmPackage "{{ . }}"
{{-   end }}
{{- else }}
Write-Host "No pnpm packages declared (skipping)" -ForegroundColor DarkGray
{{- end }}

Write-Host "`npnpm package installation complete!" -ForegroundColor White
{{- end }}

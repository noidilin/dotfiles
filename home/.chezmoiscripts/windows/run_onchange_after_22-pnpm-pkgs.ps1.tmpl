# vim: ft=powershell

{{- if eq .chezmoi.os "windows" }}

# Hash trigger: {{ include ".chezmoidata/pm/pnpm.yml" | sha256sum }}

Write-Host "=== Installing pnpm global packages ===" -ForegroundColor Yellow

{{ include ".chezmoitemplates/scripts/error-policy.ps1" }}
{{ include ".chezmoitemplates/scripts/lib/powershell/common.ps1" }}
{{ include ".chezmoitemplates/scripts/lib/powershell/pnpm.ps1" }}

if (!(Assert-MiseToolOrSkip -Tool "node" -MissingMiseMessage "WARNING: mise is not installed (skipping pnpm packages)" -MissingToolMessage "WARNING: Node.js is not available via mise (skipping pnpm packages)")) {
    exit 0
}
$nodeVersion = $script:MiseToolVersion

if (!(Assert-MiseToolOrSkip -Tool "pnpm" -MissingMiseMessage "WARNING: mise is not installed (skipping pnpm packages)" -MissingToolMessage "WARNING: pnpm is not available via mise (skipping pnpm packages)")) {
    exit 0
}

{{- if .pkgs.pnpm }}
Write-Host "`nNode.js version: $nodeVersion" -ForegroundColor DarkGray
Write-Host "Installing pnpm packages..." -ForegroundColor White
{{-   range .pkgs.pnpm }}
Install-PnpmPackage "{{ . }}"
{{-   end }}
{{- else }}
Write-Host "No pnpm packages declared (skipping)" -ForegroundColor DarkGray
{{- end }}

Write-Host "`npnpm package installation complete!" -ForegroundColor White
Write-InstallSummary
{{- end }}

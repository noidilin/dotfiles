# vim: ft=powershell

{{- if eq .chezmoi.os "windows" }}

# =============================================================================
# Hash trigger: {{ include ".chezmoidata/pm/winget.yml" | sha256sum }}
# =============================================================================

Write-Host "=== Installing platform-specific packages (Windows - WinGet) ===" -ForegroundColor Yellow

{{ include ".chezmoitemplates/scripts/error-policy.ps1" }}
{{ include ".chezmoitemplates/scripts/lib/powershell/common.ps1" }}
{{ include ".chezmoitemplates/scripts/lib/powershell/winget.ps1" }}

Assert-CommandOrExit -CommandName "winget" -ErrorMessage "ERROR: WinGet is not installed!" -HintMessage "WinGet comes with Windows 11 or can be installed via Microsoft Store (App Installer)"

# Install WinGet packages
Write-Host "`nInstalling WinGet packages..." -ForegroundColor White
{{- range .pkgs.winget }}
Install-WinGetPackage "{{ . }}"
{{- end }}

Write-Host "`nWinGet package installation complete!" -ForegroundColor White
Write-InstallSummary
{{- end }}

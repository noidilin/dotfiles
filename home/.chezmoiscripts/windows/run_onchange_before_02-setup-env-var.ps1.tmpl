# vim: ft=powershell

{{- if eq .chezmoi.os "windows" }}

Write-Host "=== Setting up environment variables ===" -ForegroundColor Yellow

$NamedEnv = @{
{{- range $key, $pathParts := .env.xdg }}
    "{{ $key }}" = "$HOME\{{ join `\` $pathParts }}"
{{- end }}
{{- range $key, $pathParts := .env.dev }}
    "{{ $key }}" = "$HOME\{{ join `\` $pathParts }}"
{{- end }}
{{- range $key, $pathParts := .env.other }}
    "{{ $key }}" = "$HOME\{{ join `\` $pathParts }}"
{{- end }}
}

foreach ($Key in $NamedEnv.Keys) {
    $expandedValue = $ExecutionContext.InvokeCommand.ExpandString($NamedEnv[$Key])

    $currentValue = [System.Environment]::GetEnvironmentVariable($Key, [System.EnvironmentVariableTarget]::User)

    if ($currentValue -eq $null -or $currentValue -ne $expandedValue) {
        Write-Host "Setting $Key = $expandedValue" -ForegroundColor Green
        [System.Environment]::SetEnvironmentVariable($Key, $expandedValue, [System.EnvironmentVariableTarget]::User)
    } else {
        Write-Host "$Key is already set correctly (skipping)" -ForegroundColor DarkGray
    }
}

$PathEntries = @(
{{- range .env.path }}
{{-   $varName := . }}
{{-   $pathParts := index $.env.dev $varName }}
{{-   if not $pathParts }}
{{-     $pathParts = index $.env.xdg $varName }}
{{-   end }}
{{-   if $pathParts }}
{{-     if eq $varName "CARGO_HOME" }}
    "$HOME\{{ join `\` $pathParts }}\bin"
{{-     else }}
    "$HOME\{{ join `\` $pathParts }}"
{{-     end }}
{{-   end }}
{{- end }}
)

$currentPath = [System.Environment]::GetEnvironmentVariable("Path", [System.EnvironmentVariableTarget]::User)
$pathArray = if ($currentPath) { $currentPath -split ';' | Where-Object { $_ -ne '' } } else { @() }

foreach ($entry in $PathEntries) {
    $expandedEntry = $ExecutionContext.InvokeCommand.ExpandString($entry)

    if ($pathArray -notcontains $expandedEntry) {
        Write-Host "Adding to PATH: $expandedEntry" -ForegroundColor Green
        $pathArray += $expandedEntry
    } else {
        Write-Host "PATH already contains: $expandedEntry (skipping)" -ForegroundColor DarkGray
    }
}

$newPath = ($pathArray | Where-Object { $_ -ne '' }) -join ';'
[System.Environment]::SetEnvironmentVariable("Path", $newPath, [System.EnvironmentVariableTarget]::User)

Write-Host "Environment variables setup complete!" -ForegroundColor White
{{- end }}

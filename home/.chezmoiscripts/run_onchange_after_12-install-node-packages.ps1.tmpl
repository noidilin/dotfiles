{{- if eq .chezmoi.os "windows" }}
# =============================================================================
# Install Node.js Global Packages (Windows)
# =============================================================================
# This script runs when .chezmoidata.toml changes
# Source: .chezmoidata.toml [dev.node.*]
# Hash trigger: {{ include ".chezmoidata.toml" | sha256sum }}
# =============================================================================

Write-Host "=== Installing Node.js global packages ===" -ForegroundColor Cyan

# Check if mise is installed
if (!(Get-Command mise -ErrorAction SilentlyContinue)) {
    Write-Host "WARNING: mise is not installed yet (skipping node package installation)" -ForegroundColor Yellow
    exit 0
}

# Check if node is available via mise
$nodeVersion = mise exec -- node --version 2>$null
if ($LASTEXITCODE -ne 0) {
    Write-Host "WARNING: Node.js is not installed via mise yet (skipping)" -ForegroundColor Yellow
    Write-Host "Run 'mise install' to install Node.js first" -ForegroundColor Yellow
    exit 0
}

Write-Host "Node.js version: $nodeVersion" -ForegroundColor DarkGray

# Function to install package if not already installed
function Install-PnpmPackage {
    param([string]$Package)
    
    Write-Host "Installing (pnpm): $Package" -ForegroundColor Green
    try {
        mise exec -- pnpm add -g $Package
    } catch {
        Write-Host "Failed to install $Package : $_" -ForegroundColor Red
    }
}

function Install-BunPackage {
    param([string]$Package)
    
    Write-Host "Installing (bun): $Package" -ForegroundColor Green
    try {
        mise exec -- bun add -g $Package
    } catch {
        Write-Host "Failed to install $Package : $_" -ForegroundColor Red
    }
}

# Install pnpm global packages
{{- if .dev.node.pnpm }}
Write-Host "`nInstalling pnpm global packages..." -ForegroundColor Yellow
{{- range .dev.node.pnpm }}
Install-PnpmPackage "{{ . }}"
{{- end }}
{{- end }}

# Install bun global packages
{{- if .dev.node.bun }}
Write-Host "`nInstalling bun global packages..." -ForegroundColor Yellow
{{- range .dev.node.bun }}
Install-BunPackage "{{ . }}"
{{- end }}
{{- end }}

Write-Host "`nNode.js package installation complete!" -ForegroundColor Green
{{- end }}

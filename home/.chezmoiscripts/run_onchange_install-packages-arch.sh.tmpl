#!/bin/bash
# vim: ft=bash

{{- if eq .chezmoi.os "linux" }}
{{- if eq .chezmoi.osRelease.id "arch" }}

# =============================================================================
# Install Essential Packages for Arch Linux
# =============================================================================
# This script runs when .chezmoidata.toml changes
# Source: .chezmoidata.toml [packages.*.linux.pacman, packages.cli.common.tools]
# Hash trigger: {{ include ".chezmoidata.toml" | sha256sum }}
# =============================================================================

set -euo pipefail

echo "=== Installing essential packages for Arch Linux ==="

# Update package database
sudo pacman -Syu --noconfirm

# Build package list from .chezmoidata.toml
packages=(
    # Core shell (always needed)
    nushell
    
    # CLI tools (common across platforms, with name mapping)
{{- range .packages.cli.common.tools }}
    {{- $pkg := . }}
    {{- if eq $pkg "delta" -}}
    git-delta
    {{- else if eq $pkg "gpg" -}}
    gnupg
    {{- else if eq $pkg "openssh" -}}
    openssh  # Usually pre-installed
    {{- else -}}
    {{ $pkg }}
    {{- end }}
{{- end }}
    
    # Linux-specific CLI tools
{{- range .packages.cli.linux.pacman }}
    {{ . }}
{{- end }}
    
    # Editors
{{- range .packages.editor.linux.pacman }}
    {{ . }}
{{- end }}
    
    # GUI applications
{{- range .packages.gui.linux.pacman }}
    {{ . }}
{{- end }}
    
    # Development toolchain
{{- range .dev.toolchain.linux.pacman }}
    {{ . }}
{{- end }}
)

# Install packages
for package in "${packages[@]}"; do
    if ! pacman -Q "$package" &>/dev/null; then
        echo "Installing $package..."
        sudo pacman -S --noconfirm "$package" || echo "Failed to install $package"
    else
        echo "$package is already installed"
    fi
done

# Set nushell as default shell if not already set
if [[ "$SHELL" != *"nu"* ]]; then
    echo "Setting nushell as default shell..."
    nu_path=$(which nu)
    
    # Add nu to /etc/shells if not present
    if ! grep -q "$nu_path" /etc/shells; then
        echo "$nu_path" | sudo tee -a /etc/shells
    fi
    
    # Change default shell
    chsh -s "$nu_path"
    echo "Default shell changed to nushell. Please log out and log back in."
fi

echo "Package installation complete!"

{{- end }}
{{- end }}

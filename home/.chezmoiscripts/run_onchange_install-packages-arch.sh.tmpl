#!/bin/bash
# vim: ft=bash

{{- if eq .chezmoi.os "linux" }}
{{- if eq .chezmoi.osRelease.id "arch" }}

# =============================================================================
# Install Essential Packages for Arch Linux
# =============================================================================
# Execution Order: No number (run_onchange_*)
# - Runs on every `chezmoi apply` when .chezmoidata.toml changes
# - Installs system packages via pacman
# - Should run before Node.js package script (12)
# Source: .chezmoidata.toml [packages.*.linux.pacman, packages.cli.common.tools]
# Hash trigger: {{ include ".chezmoidata.toml" | sha256sum }}
# =============================================================================

set -euo pipefail

# Color codes
CYAN='\033[36m'
GREEN='\033[32m'
YELLOW='\033[33m'
GRAY='\033[90m'
RESET='\033[0m'

echo -e "${CYAN}=== Installing essential packages for Arch Linux ===${RESET}"

# Update package database
sudo pacman -Syu --noconfirm

# Build package list from .chezmoidata.toml
packages=(
    # Core shell (always needed)
    nushell
    
    # CLI tools (common across platforms, with name mapping)
{{- range .packages.cli.common.tools }}
    {{- $pkg := . }}
    {{- if eq $pkg "delta" -}}
    git-delta
    {{- else if eq $pkg "gpg" -}}
    gnupg
    {{- else if eq $pkg "openssh" -}}
    openssh  # Usually pre-installed
    {{- else -}}
    {{ $pkg }}
    {{- end }}
{{- end }}
    
    # Linux-specific CLI tools
{{- range .packages.cli.linux.pacman }}
    {{ . }}
{{- end }}
    
    # Editors
{{- range .packages.editor.linux.pacman }}
    {{ . }}
{{- end }}
    
    # GUI applications
{{- range .packages.gui.linux.pacman }}
    {{ . }}
{{- end }}
    
    # Development toolchain
{{- range .dev.toolchain.linux.pacman }}
    {{ . }}
{{- end }}
)

# Install packages
for package in "${packages[@]}"; do
    if ! pacman -Q "$package" &>/dev/null; then
        echo -e "${GREEN}Installing: $package${RESET}"
        sudo pacman -S --noconfirm "$package" || echo -e "${YELLOW}Failed to install $package${RESET}"
    else
        echo -e "${GRAY}$package is already installed (skipping)${RESET}"
    fi
done

# Set nushell as default shell if not already set
if [[ "$SHELL" != *"nu"* ]]; then
    echo "Setting nushell as default shell..."
    nu_path=$(which nu)
    
    # Add nu to /etc/shells if not present
    if ! grep -q "$nu_path" /etc/shells; then
        echo "$nu_path" | sudo tee -a /etc/shells
    fi
    
    # Change default shell
    chsh -s "$nu_path"
    echo "Default shell changed to nushell. Please log out and log back in."
fi

echo -e "${GREEN}Package installation complete!${RESET}"

{{- end }}
{{- end }}

#!/bin/bash
# vim: ft=bash

{{- if eq .chezmoi.os "darwin" }}

# =============================================================================
# Hash trigger: {{ include ".chezmoidata/pm/pnpm.yml" | sha256sum }}
# =============================================================================

set -euo pipefail

CYAN='\033[36m'
GREEN='\033[32m'
YELLOW='\033[33m'
RED='\033[31m'
GRAY='\033[90m'
WHITE='\033[97m'
RESET='\033[0m'

printf "${YELLOW}=== Installing pnpm global packages ===${RESET}\n"

installed_count=0
skipped_count=0
failed_count=0
declare -a FAILED_ITEMS=()

record_installed() {
  ((installed_count+=1))
}

record_skipped() {
  ((skipped_count+=1))
}

record_failed() {
  local manager="$1"
  local package="$2"
  ((failed_count+=1))
  FAILED_ITEMS+=("${manager}:${package}")
}

print_summary() {
  printf "\n${WHITE}Summary: installed=%d skipped=%d failed=%d${RESET}\n" "$installed_count" "$skipped_count" "$failed_count"
  if [[ $failed_count -gt 0 ]]; then
    printf "${RED}Failed items:${RESET}\n"
    for item in "${FAILED_ITEMS[@]}"; do
      printf "${RED}- %s${RESET}\n" "$item"
    done
  fi
}

if ! command -v mise &>/dev/null; then
  printf "${RED}WARNING: mise is not installed (skipping pnpm packages)${RESET}\n"
  exit 0
fi

if ! node_version=$(mise exec -- node --version 2>/dev/null); then
  printf "${RED}WARNING: Node.js is not available via mise (skipping pnpm packages)${RESET}\n"
  exit 0
fi

# Corepack will prompt to install pnpm if pnpm has not been installed yet.
pnpm_version=$(mise exec -- pnpm --version)

declare -a PNPM_INSTALLED=()
pnpm_cache_loaded=0

load_pnpm_packages() {
  if [[ $pnpm_cache_loaded -eq 1 ]]; then
    return
  fi

  pnpm_cache_loaded=1
  local output
  if ! output=$(mise exec -- pnpm ls -g --depth=0 2>/dev/null); then
    PNPM_INSTALLED=()
    return
  fi

  # Use ripgrep to extract package names: filter lines starting with @ or lowercase, exclude "dependencies:"
  while IFS= read -r pkg; do
    if [[ -n "$pkg" ]]; then
      PNPM_INSTALLED+=("$pkg")
    fi
  done < <(echo "$output" | rg -N '^[@a-z]' | rg -o '^\S+' | rg -v '^dependencies:$')
}

pnpm_package_installed() {
  local package="$1"
  load_pnpm_packages

  for existing in "${PNPM_INSTALLED[@]:-}"; do
    if [[ "$existing" == "$package" ]]; then
      return 0
    fi
  done

  return 1
}

install_pnpm_package() {
  local package="$1"

  if pnpm_package_installed "$package"; then
    printf "${GRAY}%s is already installed via pnpm (skipping)${RESET}\n" "$package"
    record_skipped
    return
  fi

  printf "${WHITE}Installing (pnpm): %s${RESET}\n" "$package"
  if ! mise exec -- pnpm add -g "$package"; then
    printf "${RED}Failed to install %s (pnpm)${RESET}\n" "$package"
    record_failed "pnpm" "$package"
  else
    record_installed
  fi
}

{{- if .pkgs.pnpm }}
printf "${GRAY}\nNode.js version: %s${RESET}\n" "$node_version"
printf "${WHITE}Installing pnpm packages...${RESET}\n"
{{- range .pkgs.pnpm }}
install_pnpm_package "{{ . }}"
{{- end }}
{{- else }}
printf "${GRAY}No pnpm packages declared (skipping)${RESET}\n"
{{- end }}

printf "${WHITE}\npnpm package installation complete!${RESET}\n"
print_summary
{{- end }}

#!/bin/bash
# vim: ft=bash

{{- if eq .chezmoi.os "darwin" }}

# =============================================================================
# Hash trigger: {{ include ".chezmoidata/pm/pnpm.yml" | sha256sum }}
# =============================================================================

set -euo pipefail

{{ include ".chezmoitemplates/scripts/lib/bash/common.sh" }}
{{ include ".chezmoitemplates/scripts/error-policy.sh" }}
{{ include ".chezmoitemplates/scripts/lib/bash/pnpm.sh" }}

print_header "Installing pnpm global packages"

require_command_or_skip "mise" "WARNING: mise is not installed (skipping pnpm packages)"

if ! node_version=$(mise exec -- node --version 2>/dev/null); then
  print_error "WARNING: Node.js is not available via mise (skipping pnpm packages)"
  exit 0
fi

# Corepack will prompt to install pnpm if pnpm has not been installed yet.
pnpm_version=$(mise exec -- pnpm --version)

{{- if .pkgs.pnpm }}
print_skip ""
print_skip "Node.js version: $node_version"
print_info "Installing pnpm packages..."
{{- range .pkgs.pnpm }}
pnpm_install_package "{{ . }}"
{{- end }}
{{- else }}
print_skip "No pnpm packages declared (skipping)"
{{- end }}

print_info ""
print_info "pnpm package installation complete!"
print_summary
{{- end }}

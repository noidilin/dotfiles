#!/bin/bash
# vim: ft=bash

{{- if eq .chezmoi.os "darwin" }}

# =============================================================================
# Hash trigger: {{ include ".chezmoidata/pm/common.yml" | sha256sum }}
# =============================================================================

set -euo pipefail

{{ include ".chezmoitemplates/scripts/lib/bash/common.sh" }}
{{ include ".chezmoitemplates/scripts/error-policy.sh" }}
{{ include ".chezmoitemplates/scripts/lib/bash/brew.sh" }}

print_header "Installing common packages (macOS)"

require_command_or_exit "brew" "ERROR: Homebrew is not installed!" "Please install Homebrew first: https://brew.sh"
brew_update_once

# Install common packages via Homebrew
print_info ""
print_info "Installing common packages via Homebrew..."
{{- range $name, $pkg := .pkgs.common }}
{{- if hasKey $pkg "brew" }}
brew_install_package "{{ $pkg.brew }}"
{{- end }}
{{- end }}

print_info ""
print_info "Common package installation complete!"
print_summary

{{- end }}

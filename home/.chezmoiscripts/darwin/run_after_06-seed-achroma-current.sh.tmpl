#!/bin/bash
# vim: ft=bash

{{- if eq .chezmoi.os "darwin" }}

set -euo pipefail

LINK="${XDG_CONFIG_HOME:-$HOME/.config}/achroma/current"

if [ -e "$LINK" ] || [ -L "$LINK" ]; then
  printf "[achroma] variant pointer already present (%s)\n" "$(readlink "$LINK" 2>/dev/null || echo "$LINK")"
  exit 0
fi

if [ "$(defaults read -g AppleInterfaceStyle 2>/dev/null || true)" = "Dark" ]; then
  VARIANT=dark
else
  VARIANT=light
fi

mkdir -p "$(dirname "$LINK")"
ln -sfn "variants/${VARIANT}" "$LINK"
printf "[achroma] seeded variant pointer -> variants/%s\n" "$VARIANT"

{{- end }}

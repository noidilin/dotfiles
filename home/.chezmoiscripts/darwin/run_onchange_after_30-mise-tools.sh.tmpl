#!/bin/bash
# vim: ft=bash

{{- if eq .chezmoi.os "darwin" }}
# =============================================================================
# Install Mise Tools (macOS Only)
# =============================================================================
# Execution Order: 30 (run_onchange_after_30-*)
# - Runs on every `chezmoi apply` when mise.yml changes
# - Installs runtime version managers (Node, Python, Rust, Bun)
# - Requires mise to be installed (from brew in script 10)
# - Uses mise config at ~/.config/mise/config.toml (generated by chezmoi)
# Source: .chezmoidata/mise.yml
# Hash trigger: {{ include ".chezmoidata/mise.yml" | sha256sum }}
# =============================================================================

set -euo pipefail

# Color codes
CYAN='\033[36m'
GREEN='\033[32m'
YELLOW='\033[33m'
RED='\033[31m'
GRAY='\033[90m'
RESET='\033[0m'

echo -e "${CYAN}=== Installing mise tools ===${RESET}"

# Check if mise is installed
if ! command -v mise &>/dev/null; then
    echo -e "${RED}ERROR: mise is not installed!${RESET}"
    echo -e "${YELLOW}Please ensure mise is installed via Homebrew first${RESET}"
    exit 1
fi

# Verify mise config exists (should be created by chezmoi apply)
MISE_CONFIG="$HOME/.config/mise/config.toml"
if [ ! -f "$MISE_CONFIG" ]; then
    echo -e "${RED}ERROR: Mise config not found at $MISE_CONFIG${RESET}"
    echo -e "${YELLOW}Run 'chezmoi apply' to generate the mise config first${RESET}"
    exit 1
fi

echo -e "${GRAY}Using mise config: $MISE_CONFIG${RESET}"

# Install all tools defined in mise config
echo -e "\n${YELLOW}Installing tools from mise config...${RESET}"
if ! mise install; then
    echo -e "${YELLOW}WARNING: Some mise tools may have failed to install${RESET}"
fi

echo -e "\n${GREEN}Mise tools installation complete!${RESET}"
{{- end }}

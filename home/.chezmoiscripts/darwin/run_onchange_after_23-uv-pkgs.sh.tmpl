#!/bin/bash
# vim: ft=bash

{{- if eq .chezmoi.os "darwin" }}

# =============================================================================
# Hash trigger: {{ include ".chezmoidata/pm/uv.yml" | sha256sum }}
# =============================================================================

set -euo pipefail

CYAN='\033[36m'
GREEN='\033[32m'
YELLOW='\033[33m'
RED='\033[31m'
GRAY='\033[90m'
WHITE='\033[97m'
RESET='\033[0m'

printf "${YELLOW}=== Installing uv tool packages ===${RESET}\n"

installed_count=0
skipped_count=0
failed_count=0
declare -a FAILED_ITEMS=()

record_installed() {
  ((installed_count+=1))
}

record_skipped() {
  ((skipped_count+=1))
}

record_failed() {
  local manager="$1"
  local package="$2"
  ((failed_count+=1))
  FAILED_ITEMS+=("${manager}:${package}")
}

print_summary() {
  printf "\n${WHITE}Summary: installed=%d skipped=%d failed=%d${RESET}\n" "$installed_count" "$skipped_count" "$failed_count"
  if [[ $failed_count -gt 0 ]]; then
    printf "${RED}Failed items:${RESET}\n"
    for item in "${FAILED_ITEMS[@]}"; do
      printf "${RED}- %s${RESET}\n" "$item"
    done
  fi
}

if ! command -v mise &>/dev/null; then
  printf "${RED}WARNING: mise is not installed (skipping uv packages)${RESET}\n"
  exit 0
fi

if ! uv_version=$(mise exec -- uv --version 2>/dev/null); then
  printf "${RED}WARNING: uv is not available via mise (skipping uv packages)${RESET}\n"
  exit 0
fi

declare -a UV_TOOLS=()
uv_cache_loaded=0

load_uv_tools() {
  if [[ $uv_cache_loaded -eq 1 ]]; then
    return
  fi

  uv_cache_loaded=1
  local output
  if ! output=$(mise exec -- uv tool list 2>/dev/null); then
    UV_TOOLS=()
    return
  fi

  # Use ripgrep to extract package names: filter lines with "v<digit>", then extract first word
  while IFS= read -r pkg; do
    if [[ -n "$pkg" ]]; then
      UV_TOOLS+=("$pkg")
    fi
  done < <(echo "$output" | rg -N '^\S+\s+v\d' | rg -o '^\S+' | rg -v '^Installed$')
}

uv_tool_installed() {
  local package="$1"
  load_uv_tools

  for existing in "${UV_TOOLS[@]:-}"; do
    if [[ "$existing" == "$package" ]]; then
      return 0
    fi
  done

  return 1
}

install_uv_tool() {
  local package="$1"

  if uv_tool_installed "$package"; then
    printf "${GRAY}%s is already installed via uv (skipping)${RESET}\n" "$package"
    record_skipped
    return
  fi

  printf "${WHITE}Installing (uv): %s${RESET}\n" "$package"
  if ! mise exec -- uv tool install "$package"; then
    printf "${RED}Failed to install %s (uv)${RESET}\n" "$package"
    record_failed "uv" "$package"
  else
    record_installed
  fi
}

{{- if .pkgs.uv }}
printf "${GRAY}\nuv version: %s${RESET}\n" "$uv_version"
printf "${WHITE}Installing uv tools...${RESET}\n"
{{- range .pkgs.uv }}
install_uv_tool "{{ . }}"
{{- end }}
{{- else }}
printf "${GRAY}No uv tools declared (skipping)${RESET}\n"
{{- end }}

printf "${WHITE}\nuv tool installation complete!${RESET}\n"
print_summary
{{- end }}

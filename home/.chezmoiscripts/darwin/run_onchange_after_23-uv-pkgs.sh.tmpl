#!/bin/bash
# vim: ft=bash

{{- if eq .chezmoi.os "darwin" }}

# =============================================================================
# Hash trigger: {{ include ".chezmoidata/pm/uv.yml" | sha256sum }}
# =============================================================================

set -euo pipefail

{{ include ".chezmoitemplates/scripts/lib/bash/common.sh" }}
{{ include ".chezmoitemplates/scripts/error-policy.sh" }}
{{ include ".chezmoitemplates/scripts/lib/bash/uv.sh" }}

print_header "Installing uv tool packages"

require_command_or_skip "mise" "WARNING: mise is not installed (skipping uv packages)"

if ! uv_version=$(mise exec -- uv --version 2>/dev/null); then
  print_error "WARNING: uv is not available via mise (skipping uv packages)"
  exit 0
fi

{{- if .pkgs.uv }}
print_skip ""
print_skip "uv version: $uv_version"
print_info "Installing uv tools..."
{{- range .pkgs.uv }}
uv_install_tool "{{ . }}"
{{- end }}
{{- else }}
print_skip "No uv tools declared (skipping)"
{{- end }}

print_info ""
print_info "uv tool installation complete!"
print_summary
{{- end }}

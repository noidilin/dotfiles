#!/usr/bin/env bash
#   run.py:       {{ include "dot_local/etc/claude-desktop/metaage-aws-estimator-run.py" | sha256sum }}
#   requirements: {{ include "dot_local/share/metaage-aws-estimator/requirements.txt" | sha256sum }}
#   mise.toml:    {{ include "dot_local/share/metaage-aws-estimator/mise.toml" | sha256sum }}

set -euo pipefail

{{- if eq .chezmoi.os "darwin" }}

RUNTIME_DIR="${HOME}/.local/share/metaage-aws-estimator"

if ! command -v mise &>/dev/null; then
  printf "[ERROR] mise is not installed; cannot build the estimator venv.\n" >&2
  exit 1
fi

if [[ ! -f "${RUNTIME_DIR}/mise.toml" ]]; then
  printf "[ERROR] %s/mise.toml missing; run 'chezmoi apply' first.\n" "${RUNTIME_DIR}" >&2
  exit 1
fi

cd "${RUNTIME_DIR}"

if ! mise run install &>/dev/null; then
  printf "[ERROR] 'mise run install' failed in %s; rerun it by hand.\n" "${RUNTIME_DIR}" >&2
  exit 1
fi
printf "[estimator] venv ready (%s/.venv)\n" "${RUNTIME_DIR}"

mise run --quiet patch

{{- else }}

printf "[estimator] Skipping (macOS only)\n"

{{- end }}

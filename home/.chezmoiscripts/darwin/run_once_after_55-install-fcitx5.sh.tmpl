#!/bin/bash
# vim: ft=bash
# Install Fcitx5-Rime for macOS (one-time manual installation)
# Fcitx5 cannot be installed via Homebrew, so we download the official installer

{{- if eq .chezmoi.os "darwin" }}

set -euo pipefail

# Color codes (matching existing scripts)
CYAN='\033[36m'
GREEN='\033[32m'
YELLOW='\033[33m'
RED='\033[31m'
GRAY='\033[90m'
WHITE='\033[97m'
RESET='\033[0m'

DOWNLOAD_URL="https://github.com/fcitx-contrib/fcitx5-macos-installer/releases/download/latest/Fcitx5-Rime.zip"
WORK_DIR="/tmp/fcitx5-install"
ZIP_FILE="${WORK_DIR}/Fcitx5-Rime.zip"
INSTALLER_APP="${WORK_DIR}/Fcitx5Installer.app"

echo -e "${YELLOW}=== Installing Fcitx5-Rime for macOS ===${RESET}"

# Create work directory
mkdir -p "${WORK_DIR}"
cd "${WORK_DIR}"

# Clean up any existing files
echo -e "${CYAN}Preparing installation directory...${RESET}"
rm -rf Fcitx5Installer.app Fcitx5-Rime.zip

# Download installer
echo -e "${CYAN}Downloading Fcitx5-Rime installer...${RESET}"
if ! curl -fsSL "${DOWNLOAD_URL}" -o "${ZIP_FILE}"; then
    echo -e "${RED}ERROR: Failed to download Fcitx5 installer${RESET}"
    echo -e "${GRAY}URL: ${DOWNLOAD_URL}${RESET}"
    exit 1
fi
echo -e "${GREEN}✓ Download complete${RESET}"

# Extract
echo -e "${CYAN}Extracting installer...${RESET}"
if ! unzip -q "${ZIP_FILE}"; then
    echo -e "${RED}ERROR: Failed to extract installer${RESET}"
    exit 1
fi
echo -e "${GREEN}✓ Extraction complete${RESET}"

# Clean up zip file
rm -f "${ZIP_FILE}"

# Display manual installation instructions
echo ""
echo -e "${YELLOW}═══════════════════════════════════════════════════════════${RESET}"
echo -e "${YELLOW}  MANUAL INSTALLATION REQUIRED${RESET}"
echo -e "${YELLOW}═══════════════════════════════════════════════════════════${RESET}"
echo ""
echo -e "The Fcitx5 installer will now open."
echo -e "Please complete these steps:"
echo ""
echo -e "  ${WHITE}1. Click 'Install' in the Fcitx5Installer window${RESET}"
echo -e "  ${WHITE}2. Wait for installation to complete${RESET}"
echo -e "  ${WHITE}3. Close the installer when finished${RESET}"
echo -e "  ${WHITE}4. Configure Fcitx5 in System Settings:${RESET}"
echo -e "     ${GRAY}• System Settings → Keyboard → Input Sources${RESET}"
echo -e "     ${GRAY}• Add 'Fcitx5' as an input source${RESET}"
echo -e "     ${GRAY}• Configure keyboard shortcuts as needed${RESET}"
echo ""
echo -e "${CYAN}Note: Your Rime config is already in ~/.config/rime/${RESET}"
echo ""

# Open installer app
echo -e "${CYAN}Opening installer...${RESET}"
if ! open "${INSTALLER_APP}"; then
    echo -e "${RED}ERROR: Failed to open installer${RESET}"
    echo -e "${YELLOW}Please manually open: ${INSTALLER_APP}${RESET}"
    exit 1
fi

echo -e "${GREEN}✓ Installer launched${RESET}"
echo -e "${GRAY}Waiting for you to complete the installation...${RESET}"
echo ""

# Wait for user to complete installation (optional: wait for them to press enter)
read -p "Press Enter once you've completed the installation to clean up temporary files..."

# Clean up installation directory
echo -e "${CYAN}Cleaning up temporary files...${RESET}"
rm -rf "${WORK_DIR}"
echo -e "${GREEN}✓ Cleanup complete${RESET}"

echo ""
echo -e "${GREEN}Fcitx5 installation process complete!${RESET}"
echo -e "${GRAY}You can now use Fcitx5 with your Rime configuration.${RESET}"
echo ""

{{- end }}

# vim:ft=gitignore.chezmoitmpl

**/.DS_Store

### chezmoi ###

.config/chezmoi/**
chezmoi-crypto-key.txt.age # age passphrase key for chezmoi to decryp private key

### script files ###

{{- if ne .chezmoi.os "linux" }}
# Non-Linux: Ignore all Arch scripts
.chezmoiscripts/arch/**
{{- else if eq .osId "linux-arch" }}
# Arch Linux: Filter based on environment
{{-   if eq .archEnv "wsl" }}
# WSL2: Ignore native scripts
.chezmoiscripts/arch/native/**
{{-   else if eq .archEnv "native" }}
# Native: Ignore WSL scripts
.chezmoiscripts/arch/wsl/**
{{-   end }}
{{- else }}
# Other Linux distros: Ignore all Arch scripts
.chezmoiscripts/arch/**
{{- end }}

{{- if ne .chezmoi.os "windows" }}
.chezmoiscripts/windows/**
{{- end }}

{{- if ne .chezmoi.os "darwin" }}
.chezmoiscripts/darwin/**
{{- end }}

### config directory ###

{{- if ne .chezmoi.os "linux" }}
.config/fcitx5/
.config/hypr/
.config/systemd/
{{- end }}

{{- if ne .chezmoi.os "windows" }}
.glzr/
scoop/
.config/cursor/
.config/flow-launcher/
.config/pwsh/
.config/setup-win/
.config/winterm/
FlexASIO.toml
.wslconfig
{{- end }}

{{- if ne .chezmoi.os "darwin" }}
.zshenv
.zshrc
.aerospace.toml
.config/zsh/*
.config/karabiner/
{{- end }}

{{- if ne .osId "linux-arch" }}
.bash_profile
{{- end }}

{{- if eq .chezmoi.os "windows" }}
# Windows: Exclude fcitx5 configs (not used on Windows)
.config/fcitx5/
{{- end }}

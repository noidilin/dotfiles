{{- if eq .chezmoi.os "darwin" }}
# colima: ssh host for the VM. Kept here so colima finds it and skips prepending its own.
# Must stay above any Host blocks.
Include ~/.dev/colima/ssh_config

# 1Password SSH Agent
Host *
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- end }}
